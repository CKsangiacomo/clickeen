{
  "component": "toggle",
  "syntax": "<tooldrawer-field type='toggle' label='{{LABEL}}' size='{{SIZE}}' path='{{PATH}}' />",
  "attributes": {
    "type": { "fixed": "toggle" },
    "label": { "required": true },
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "path": { "required": true },
    "disabled": { "optional": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "boolean" },
  "defaults": [
    {
      "id": "toggle",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-toggle", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "label": "Label",
        "id": "toggle-{{size}}",
        "path": "",
        "checkedAttr": " checked",
        "disabled": false
      }
    },
    {
      "id": "toggle-off",
      "title": "Off",
      "sizes": ["md"],
      "spec": ["diet-toggle", "data-size='md'", "unchecked"],
      "context": {
        "size": "md",
        "label": "Label",
        "id": "toggle-off",
        "path": "",
        "checkedAttr": "",
        "disabled": false
      }
    },
    {
      "id": "toggle-disabled",
      "title": "Disabled",
      "sizes": ["md"],
      "spec": ["diet-toggle", "data-size='md'", "disabled"],
      "context": {
        "size": "md",
        "label": "Label",
        "id": "toggle-disabled",
        "path": "",
        "checkedAttr": " checked",
        "disabled": true
      }
    }
  ]
}
