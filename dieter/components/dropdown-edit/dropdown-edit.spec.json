{
  "component": "dropdown-edit",
  "description": "Inline rich text editor with popover workflow",
  "syntax": "<tooldrawer-field type='dropdown-edit' label='{{LABEL}}' size='{{SIZE}}' popover-width='{{POPOVER_WIDTH}}' path='{{PATH}}' placeholder='{{PLACEHOLDER}}' />",
  "attributes": {
    "type": {
      "value": "dropdown-edit",
      "required": true,
      "description": "Component type identifier"
    },
    "label": {
      "type": "string",
      "required": true,
      "description": "Title shown in the editor popover header",
      "example": "Heading"
    },
    "headerLabel": {
      "type": "string",
      "optional": true,
      "description": "Label rendered in the shared popover header"
    },
    "size": {
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "md",
      "required": false,
      "description": "Closed control size - sm (20px), md (24px), lg (28px) height"
    },
    "popoverWidth": {
      "type": "enum",
      "values": ["row", "wide", "extra-wide"],
      "default": "extra-wide",
      "required": false,
      "description": "Open Popover width: row, wide (+40px), or extra-wide (+80px)"
    },
    "path": {
      "type": "string",
      "required": true,
      "description": "Data path in instanceData for binding (e.g., 'heading', 'description')"
    },
    "placeholder": {
      "type": "string",
      "default": "The quick brown fox jumps over the lazy dog",
      "required": false,
      "description": "Default text content shown in preview and editor"
    },
    "addLinkLabel": { "type": "string", "required": true },
    "boldLabel": { "type": "string", "required": true },
    "clearFormattingLabel": { "type": "string", "required": true },
    "closeLinkLabel": { "type": "string", "required": true },
    "italicLabel": { "type": "string", "required": true },
    "linkLabel": { "type": "string", "required": true },
    "removeLinkLabel": { "type": "string", "required": true },
    "strikethroughLabel": { "type": "string", "required": true },
    "underlineLabel": { "type": "string", "required": true },
    "urlLabel": { "type": "string", "required": true }
  },
  "features": {
    "richTextFormatting": ["Bold", "Italic", "Underline", "Strikethrough"],
    "linkPanel": "Add or remove a hyperlink on selected text"
  },
  "defaults": [
    {
      "id": "dropdown-edit",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-dropdown-edit", "data-size='{{size}}'"],
      "context": {
        "size": "sm",
        "popoverWidth": "extra-wide",
        "id": "dropdown-edit-{{size}}",
        "label": "Label",
        "headerLabel": "Label",
        "placeholder": "The quick brown fox jumps over the lazy dog",
        "path": "",
        "addLinkLabel": "Add link",
        "boldLabel": "Bold",
        "clearFormattingLabel": "Clear formatting",
        "closeLinkLabel": "Close link editor",
        "italicLabel": "Italic",
        "linkLabel": "Link",
        "removeLinkLabel": "Remove link",
        "strikethroughLabel": "Strikethrough",
        "underlineLabel": "Underline",
        "urlLabel": "URL",
        "state": "closed",
        "expanded": "false"
      },
      "sizeContext": {
        "sm": { "labelClass": "label-xs", "bodyClass": "body-xs" },
        "md": { "labelClass": "label-s", "bodyClass": "body-s" },
        "lg": { "labelClass": "label-m", "bodyClass": "body-m" }
      }
    },
    {
      "id": "dropdown-edit-wide-popover",
      "title": "Open editor — wide (+40px)",
      "sizes": ["md"],
      "spec": ["diet-dropdown-edit", "data-size='md'", "popover-width='wide'", "data-state='open'"],
      "context": {
        "size": "md",
        "popoverWidth": "wide",
        "id": "dropdown-edit-wide-popover",
        "label": "Description",
        "headerLabel": "Description",
        "placeholder": "Make selected text bold, italic, underlined, struck through, or linked.",
        "path": "",
        "addLinkLabel": "Add link",
        "boldLabel": "Bold",
        "clearFormattingLabel": "Clear formatting",
        "closeLinkLabel": "Close link editor",
        "italicLabel": "Italic",
        "linkLabel": "Link",
        "removeLinkLabel": "Remove link",
        "strikethroughLabel": "Strikethrough",
        "underlineLabel": "Underline",
        "urlLabel": "URL",
        "state": "open",
        "expanded": "true"
      },
      "sizeContext": {
        "md": { "labelClass": "label-s", "bodyClass": "body-s" }
      }
    },
    {
      "id": "dropdown-edit-extra-wide-popover",
      "title": "Open editor — extra-wide (+80px)",
      "sizes": ["md"],
      "spec": [
        "diet-dropdown-edit",
        "data-size='md'",
        "popover-width='extra-wide'",
        "data-state='open'"
      ],
      "context": {
        "size": "md",
        "popoverWidth": "extra-wide",
        "id": "dropdown-edit-extra-wide-popover",
        "label": "Description",
        "headerLabel": "Description",
        "placeholder": "Make selected text bold, italic, underlined, struck through, or linked.",
        "path": "",
        "addLinkLabel": "Add link",
        "boldLabel": "Bold",
        "clearFormattingLabel": "Clear formatting",
        "closeLinkLabel": "Close link editor",
        "italicLabel": "Italic",
        "linkLabel": "Link",
        "removeLinkLabel": "Remove link",
        "strikethroughLabel": "Strikethrough",
        "underlineLabel": "Underline",
        "urlLabel": "URL",
        "state": "open",
        "expanded": "true"
      },
      "sizeContext": {
        "md": { "labelClass": "label-s", "bodyClass": "body-s" }
      }
    }
  ],
  "dataBinding": {
    "automatic": true,
    "description": "Editor content automatically syncs to instanceData[path] as HTML string with inline formatting"
  }
}
