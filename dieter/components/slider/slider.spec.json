{
  "component": "slider",
  "syntax": "<tooldrawer-field type='slider' label='{{LABEL}}' size='{{SIZE}}' path='{{PATH}}' min='{{MIN}}' max='{{MAX}}' value='{{VALUE}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "block": { "optional": true },
    "id": { "required": true },
    "path": { "required": true },
    "label": { "required": true },
    "min": { "optional": true },
    "max": { "optional": true },
    "value": { "optional": true },
    "disabled": { "optional": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "number" },
  "defaults": [
    {
      "id": "slider",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-slider", "data-size='{{size}}'"],
      "context": {
        "block": "",
        "size": "md",
        "id": "slider-{{size}}",
        "label": "Label",
        "min": "0",
        "max": "100",
        "value": "50",
        "disabled": false,
        "path": ""
      },
      "sizeContext": {
        "sm": { "value": "20" },
        "md": { "value": "50" },
        "lg": { "value": "80" }
      }
    },
    {
      "id": "slider-disabled",
      "title": "Disabled",
      "sizes": ["md"],
      "spec": ["diet-slider", "data-size='md'", "disabled"],
      "context": {
        "block": "",
        "size": "md",
        "id": "slider-disabled",
        "label": "Label",
        "min": "0",
        "max": "100",
        "value": "50",
        "disabled": true,
        "path": ""
      }
    }
  ]
}
