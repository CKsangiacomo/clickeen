{
  "component": "agent-activity",
  "syntax": "<div class='diet-agent-activity' data-size='{{SIZE}}' data-tone='{{TONE}}'>...</div>",
  "attributes": {
    "size": { "enum": ["sm", "md"], "default": "sm" },
    "tone": { "enum": ["active"], "default": "active" },
    "title": { "required": true },
    "rows": { "required": true }
  },
  "binding": { "type": "transient-agent-narration" },
  "presentation": {
    "activeSurface": "--color-system-purple-5 in both the padding-box surface and backing border-box layer",
    "activeBorder": "1px rotating conic highlight: transparent through 25%, --color-system-purple, --color-system-indigo at 99%, then transparent",
    "activeMotion": "3s linear infinite",
    "reducedMotion": "static conic highlight"
  },
  "defaults": [
    {
      "id": "agent-activity",
      "sizes": ["sm", "md"],
      "variants": ["active"],
      "spec": ["diet-agent-activity", "data-size='{{size}}'", "data-tone='{{tone}}'"],
      "context": {
        "size": "sm",
        "tone": "active",
        "title": "Translation Agent",
        "rows": [
          {
            "message": "Writing translations"
          },
          {
            "message": "Saving locale overlays"
          }
        ]
      }
    }
  ]
}
