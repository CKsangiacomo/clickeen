{
  "component": "dropdown-fill",
  "syntax": "<tooldrawer-field type='dropdown-fill' size='{{SIZE}}' popover-width='{{POPOVER_WIDTH}}' path='{{PATH}}' label='{{LABEL}}' placeholder='{{PLACEHOLDER}}' value='{{VALUE}}' fill-modes='{{FILL_MODES}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "popoverWidth": { "enum": ["row", "wide", "extra-wide"], "default": "wide" },
    "path": { "optional": true },
    "label": { "optional": true },
    "placeholder": { "optional": true },
    "value": { "optional": true },
    "fillModes": { "required": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "string" },
  "features": {
    "modes": "The caller declares the exact solid-color, gradient, image, and video modes it uses.",
    "copy": "The consuming Widget supplies all visible words through its adjacent ToolDrawer label file.",
    "value": "One exact JSON fill value is projected by the host before hydration and emitted on each edit."
  },
  "defaults": [
    {
      "id": "dropdown-fill",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-dropdown-fill", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "popoverWidth": "wide",
        "state": "closed",
        "expanded": "false",
        "id": "dropdown-fill-{{size}}",
        "label": "Fill",
        "placeholder": "No fill",
        "value": "{\"type\":\"none\"}",
        "path": "",
        "fillModes": "color,gradient,image,video",
        "colorFillLabel": "Color fill",
        "gradientFillLabel": "Gradient fill",
        "imageFillLabel": "Image fill",
        "videoFillLabel": "Video fill",
        "colorLabel": "Color",
        "defaultColorsLabel": "Default colors",
        "hueLabel": "Hue",
        "opacityLabel": "Opacity",
        "hexLabel": "Hex",
        "angleLabel": "Angle",
        "gradientStopsLabel": "Gradient stops",
        "addGradientStopLabel": "Add gradient stop",
        "editGradientStopLabel": "Edit gradient stop",
        "removeGradientStopLabel": "Remove gradient stop",
        "removeFillLabel": "Remove fill",
        "uploadLabel": "Upload",
        "chooseAssetsLabel": "Choose from assets",
        "removeAssetLabel": "Remove asset",
        "loadingAssetsLabel": "Loading assets…",
        "noAssetsLabel": "No assets",
        "useAssetLabel": "Use",
        "loadAssetsErrorLabel": "Assets could not be loaded.",
        "uploadAssetErrorLabel": "Asset upload failed.",
        "previewAssetErrorLabel": "Asset preview could not be loaded."
      }
    },
    {
      "id": "dropdown-fill-open",
      "title": "Open fill editor",
      "sizes": ["md"],
      "spec": ["diet-dropdown-fill", "popover-width='wide'", "data-state='open'"],
      "context": {
        "size": "md",
        "popoverWidth": "wide",
        "state": "open",
        "expanded": "true",
        "id": "dropdown-fill-open",
        "label": "Background",
        "placeholder": "No fill",
        "value": "{\"type\":\"color\",\"color\":\"#007aff\"}",
        "path": "",
        "fillModes": "color,gradient,image,video",
        "colorFillLabel": "Color fill",
        "gradientFillLabel": "Gradient fill",
        "imageFillLabel": "Image fill",
        "videoFillLabel": "Video fill",
        "colorLabel": "Color",
        "defaultColorsLabel": "Default colors",
        "hueLabel": "Hue",
        "opacityLabel": "Opacity",
        "hexLabel": "Hex",
        "angleLabel": "Angle",
        "gradientStopsLabel": "Gradient stops",
        "addGradientStopLabel": "Add gradient stop",
        "editGradientStopLabel": "Edit gradient stop",
        "removeGradientStopLabel": "Remove gradient stop",
        "removeFillLabel": "Remove fill",
        "uploadLabel": "Upload",
        "chooseAssetsLabel": "Choose from assets",
        "removeAssetLabel": "Remove asset",
        "loadingAssetsLabel": "Loading assets…",
        "noAssetsLabel": "No assets",
        "useAssetLabel": "Use",
        "loadAssetsErrorLabel": "Assets could not be loaded.",
        "uploadAssetErrorLabel": "Asset upload failed.",
        "previewAssetErrorLabel": "Asset preview could not be loaded."
      }
    }
  ]
}
