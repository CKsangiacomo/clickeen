{
  "component": "segmented",
  "description": "Multi-option segmented control built from Dieter Buttons and radio inputs.",
  "syntax": "<div class='diet-segmented-{{VARIANT}}' role='radiogroup' data-size='{{SIZE}}' aria-label='{{ARIA_LABEL}}'>…</div>",
  "attributes": {
    "variant": { "type": "enum", "values": ["ic", "ictxt", "txt"], "default": "ictxt", "required": true },
    "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md", "required": false },
    "ariaLabel": { "type": "string", "required": true },
    "groupName": { "type": "string", "required": true },
    "buttonSize": { "type": "enum", "values": ["small", "medium", "large"], "default": "medium", "required": false },
    "buttonType": { "type": "enum", "values": ["primary", "secondary", "tertiary", "quaternary"], "default": "quaternary", "required": false },
    "buttonIconSize": { "type": "enum", "values": ["12", "16", "20", "24", "28", "32", "36", "40"], "default": "16", "required": false },
    "segments": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "fields": {
          "value": { "type": "string", "required": true },
          "label": { "type": "string", "required": false },
          "icon": { "type": "string", "required": false },
          "srLabel": { "type": "string", "required": false },
          "checked": { "type": "boolean", "required": false },
          "disabled": { "type": "boolean", "required": false }
        }
      }
    }
  },
  "defaults": [
    {
      "id": "segmented",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-segmented", "data-size='{{size}}'"],
      "context": {
        "variant": "txt", "size": "md", "ariaLabel": "Selection", "groupName": "selection-{{size}}",
        "buttonSize": "medium", "buttonType": "quaternary", "buttonIconSize": "16",
        "segments": [{ "value": "one", "label": "One", "checked": true }, { "value": "two", "label": "Two" }]
      },
      "sizeContext": {
        "sm": { "buttonSize": "small", "buttonIconSize": "12" },
        "md": { "buttonSize": "medium", "buttonIconSize": "16" },
        "lg": { "buttonSize": "large", "buttonIconSize": "20" }
      }
    },
    {
      "id": "segmented-ictxt",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-segmented-ictxt", "data-size='{{size}}'"],
      "context": {
        "variant": "ictxt", "size": "md", "ariaLabel": "Assist mode", "groupName": "assist-mode-{{size}}",
        "buttonSize": "medium", "buttonType": "quaternary", "buttonIconSize": "16",
        "segments": [
          { "value": "manual", "label": "Manual", "icon": "hand.tap", "checked": true },
          { "value": "copilot", "label": "Copilot", "icon": "sparkles" }
        ]
      },
      "sizeContext": {
        "sm": { "buttonSize": "small", "buttonIconSize": "12" },
        "md": { "buttonSize": "medium", "buttonIconSize": "16" },
        "lg": { "buttonSize": "large", "buttonIconSize": "20" }
      }
    },
    {
      "id": "segmented-ic",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-segmented-ic", "data-size='{{size}}'"],
      "context": {
        "variant": "ic", "size": "md", "ariaLabel": "View selection", "groupName": "view-{{size}}",
        "buttonSize": "medium", "buttonType": "quaternary", "buttonIconSize": "16",
        "segments": [
          { "value": "grid", "icon": "circle.grid.2x2", "srLabel": "Grid", "checked": true },
          { "value": "list", "icon": "line.3.horizontal.decrease.circle", "srLabel": "List" }
        ]
      },
      "sizeContext": {
        "sm": { "buttonSize": "small", "buttonIconSize": "12" },
        "md": { "buttonSize": "medium", "buttonIconSize": "16" },
        "lg": { "buttonSize": "large", "buttonIconSize": "20" }
      }
    },
    {
      "id": "segmented-txt",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-segmented-txt", "data-size='{{size}}'"],
      "context": {
        "variant": "txt", "size": "md", "ariaLabel": "Alignment", "groupName": "alignment-{{size}}",
        "buttonSize": "medium", "buttonType": "quaternary", "buttonIconSize": "16",
        "segments": [
          { "value": "left", "label": "Left", "checked": true },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ]
      },
      "sizeContext": {
        "sm": { "buttonSize": "small", "buttonIconSize": "12" },
        "md": { "buttonSize": "medium", "buttonIconSize": "16" },
        "lg": { "buttonSize": "large", "buttonIconSize": "20" }
      }
    }
  ]
}
