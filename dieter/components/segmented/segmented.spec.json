{
  "component": "segmented",
  "description": "Native-radio segmented selection with caller-owned labels and Icons.",
  "syntax": "<div class='diet-segmented diet-segmented-{{VARIANT}}' role='radiogroup' data-size='{{SIZE}}' aria-label='{{ARIA_LABEL}}'>…</div>",
  "attributes": {
    "variant": { "type": "enum", "values": ["ic", "ictxt", "txt"], "default": "ictxt", "required": true },
    "size": { "type": "enum", "values": ["sm", "md", "lg"], "default": "md", "required": false },
    "ariaLabel": { "type": "string", "required": true },
    "groupName": { "type": "string", "required": true },
    "segments": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "fields": {
          "value": { "type": "string", "required": true },
          "label": { "type": "string", "required": false },
          "icon": { "type": "string", "required": false },
          "srLabel": { "type": "string", "required": false },
          "checked": { "type": "boolean", "required": false },
          "disabled": { "type": "boolean", "required": false }
        }
      }
    }
  },
  "presentation": {
    "railInset": "--space-0",
    "selectedHover": "selected surface remains unchanged"
  },
  "defaults": [
    {
      "id": "segmented-size-ladder",
      "title": "Size ladder",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-segmented-ictxt", "data-size='{{size}}'", "native radio state"],
      "context": {
        "variant": "ictxt",
        "size": "md",
        "ariaLabel": "Assist mode",
        "groupName": "assist-mode-{{size}}",
        "segments": [
          { "value": "manual", "label": "Manual", "icon": "pencil", "checked": true },
          { "value": "copilot", "label": "Copilot", "icon": "sparkles" }
        ]
      }
    },
    {
      "id": "segmented-text",
      "title": "Text",
      "spec": ["diet-segmented-txt", "data-size='md'", "selected, unselected and disabled"],
      "context": {
        "variant": "txt",
        "size": "md",
        "ariaLabel": "Alignment",
        "groupName": "alignment",
        "segments": [
          { "value": "left", "label": "Left", "checked": true },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right", "disabled": true }
        ]
      }
    },
    {
      "id": "segmented-icon",
      "title": "Icon",
      "spec": ["diet-segmented-ic", "data-size='md'", "caller-owned accessible names"],
      "context": {
        "variant": "ic",
        "size": "md",
        "ariaLabel": "View",
        "groupName": "view",
        "segments": [
          { "value": "grid", "icon": "circle.grid.2x2", "srLabel": "Grid", "checked": true },
          { "value": "list", "icon": "line.3.horizontal.decrease.circle", "srLabel": "List" },
          { "value": "more", "icon": "ellipsis", "srLabel": "More", "disabled": true }
        ]
      }
    }
  ]
}
