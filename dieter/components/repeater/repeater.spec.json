{
  "component": "repeater",
  "syntax": "<tooldrawer-field type='repeater' size='{{SIZE}}' path='{{PATH}}' label='{{LABEL}}' add-label='{{ADD_LABEL}}' reorder-label='{{REORDER_LABEL}}' remove-label='{{REMOVE_LABEL}}' move-label='{{MOVE_LABEL}}' default-item='{{DEFAULT_ITEM}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "path": { "required": true },
    "label": { "required": true },
    "labelPath": { "optional": true },
    "labelPlaceholder": { "optional": true },
    "labelInputLabel": { "optional": true },
    "default-item": { "required": true },
    "add-label": { "required": true },
    "reorder-label": { "required": true },
    "remove-label": { "required": true },
    "move-label": { "required": true },
    "add-open": { "optional": true }
  },
  "defaults": [
    {
      "id": "repeater",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-repeater", "data-size='{{size}}'"],
      "context": {
        "label": "Items",
        "addLabel": "Add item",
        "reorderLabel": "Reorder items",
        "removeLabel": "Remove item {index}",
        "moveLabel": "Move item {index}",
        "size": "md",
        "buttonSize": "medium",
        "labelClass": "label-s",
        "bodyClass": "body-s",
        "path": "items",
        "labelInputLabel": "Title",
        "labelPlaceholder": "",
        "labelPath": "",
        "defaultItem": "{&quot;id&quot;:&quot;&quot;,&quot;name&quot;:&quot;New item&quot;}",
        "value": "[{&quot;id&quot;:&quot;item-1&quot;,&quot;name&quot;:&quot;First item&quot;},{&quot;id&quot;:&quot;item-2&quot;,&quot;name&quot;:&quot;Second item&quot;}]",
        "template": "<div class=\"diet-textfield\" data-size=\"md\"><label class=\"diet-textfield__control\"><span class=\"diet-textfield__display-label\">Name</span><input class=\"diet-textfield__field\" type=\"text\" data-path=\"items.__INDEX__.name\" /></label></div>"
      },
      "sizeContext": {
        "sm": {
          "size": "sm",
          "buttonSize": "small",
          "labelClass": "label-xs",
          "bodyClass": "body-xs"
        },
        "md": {
          "size": "md",
          "buttonSize": "medium",
          "labelClass": "label-s",
          "bodyClass": "body-s"
        },
        "lg": {
          "size": "lg",
          "buttonSize": "large",
          "labelClass": "label-m",
          "bodyClass": "body-m"
        }
      }
    }
  ]
}
