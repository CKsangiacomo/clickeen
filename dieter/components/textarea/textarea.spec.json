{
  "component": "textarea",
  "syntax": "<tooldrawer-field type='textarea' size='{{SIZE}}' path='{{PATH}}' label='{{LABEL}}' placeholder='{{PLACEHOLDER}}' value='{{VALUE}}' maxlength='{{MAXLENGTH}}' />",
  "attributes": {
    "id": { "optional": true },
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "path": { "optional": true },
    "label": { "optional": true },
    "value": { "optional": true },
    "placeholder": { "optional": true, "default": "Enter text" },
    "disabled": { "optional": true, "type": "boolean" },
    "maxlength": { "optional": true, "type": "number" }
  },
  "binding": { "path": "instanceData[PATH]", "type": "string" },
  "defaults": [
    {
      "id": "textarea",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-textarea", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "id": "textarea-{{size}}",
        "path": "description",
        "label": "Description",
        "value": "",
        "placeholder": "Enter a description",
        "disabled": false,
        "maxlength": 500,
        "labelClass": "label-s",
        "bodyClass": "body-s"
      },
      "sizeContext": {
        "sm": { "labelClass": "label-xs", "bodyClass": "body-xs" },
        "md": { "labelClass": "label-s", "bodyClass": "body-s" },
        "lg": { "labelClass": "label-m", "bodyClass": "body-m" }
      }
    }
  ]
}
