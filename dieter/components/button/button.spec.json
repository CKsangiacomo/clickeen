{
  "component": "button",
  "syntax": "<button class='diet-button' data-size='{{SIZE}}' data-type='{{TYPE}}'>\u2026</button>",
  "attributes": {
    "size": {
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "required": true
    },
    "type": {
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "required": true
    },
    "tone": {
      "enum": [
        "positive",
        "saveonly"
      ],
      "optional": true
    },
    "state": {
      "enum": [
        "success"
      ],
      "optional": true
    },
    "ariaLabel": {
      "optional": true
    },
    "label": {
      "optional": true
    },
    "iconStart": {
      "optional": true
    },
    "iconEnd": {
      "optional": true
    },
    "iconSize": {
      "enum": [
        "12",
        "16",
        "20",
        "24",
        "28",
        "32",
        "36",
        "40"
      ],
      "optional": true
    },
    "loading": {
      "optional": true
    },
    "tabIndex": {
      "optional": true
    },
    "disabled": {
      "optional": true
    },
    "path": {
      "optional": true
    }
  },
  "binding": {
    "type": "caller-owned-action"
  },
  "defaults": [
    {
      "id": "button-icon-text-start",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon before label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Button",
        "iconStart": "sparkles"
      }
    },
    {
      "id": "button-icon-text-end",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon after label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Button",
        "iconEnd": "chevron.right"
      }
    },
    {
      "id": "button-icon",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon without label"
      ],
      "context": {
        "size": "medium",
        "type": "secondary",
        "iconStart": "gearshape",
        "ariaLabel": "Icon button"
      }
    },
    {
      "id": "button-text",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Text button"
      }
    },
    {
      "id": "button-loading",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "data-loading='true'",
        "caller-owned loading label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Saving\u2026",
        "loading": true,
        "disabled": true
      }
    },
    {
      "id": "button-success",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "data-state='success'",
        "caller-owned result label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "state": "success",
        "label": "Saved",
        "iconStart": "checkmark",
        "disabled": true
      }
    },
    {
      "id": "button-tone",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "tones": [
        "positive",
        "saveonly"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='primary'",
        "data-tone='{{tone}}'",
        "caller-owned action label"
      ],
      "context": {
        "size": "large",
        "type": "primary",
        "tone": "positive",
        "label": "Republish",
        "iconStart": "arrow.trianglehead.2.counterclockwise"
      }
    }
  ]
}
