{
  "component": "button",
  "syntax": "<button class='diet-button' data-size='{{SIZE}}' data-type='{{TYPE}}'>\u2026</button>",
  "attributes": {
    "size": {
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "required": true
    },
    "type": {
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "required": true
    },
    "tone": {
      "enum": [
        "save",
        "republish"
      ],
      "optional": true
    },
    "state": {
      "enum": [
        "success"
      ],
      "optional": true
    },
    "ariaLabel": {
      "optional": true
    },
    "label": {
      "optional": true
    },
    "iconStart": {
      "optional": true
    },
    "iconEnd": {
      "optional": true
    },
    "iconSize": {
      "enum": [
        "12",
        "16",
        "20",
        "24",
        "28",
        "32",
        "36",
        "40"
      ],
      "optional": true
    },
    "loading": {
      "optional": true
    },
    "tabIndex": {
      "optional": true
    },
    "disabled": {
      "optional": true
    },
    "path": {
      "optional": true
    }
  },
  "binding": {
    "type": "caller-owned-action"
  },
  "contract": {
    "hierarchy": "The required primary, secondary, tertiary, or quaternary type remains the independent visual-hierarchy axis.",
    "saveTone": "data-tone='save' keeps the editor Save command pink across ready, pending, and completed presentation.",
    "republishTone": "data-tone='republish' keeps the release command green across ready, pending, and completed presentation.",
    "stateAuthority": "The caller owns command phase, exact label, icon or Spinner composition, disabled state, and aria-busy truth."
  },
  "defaults": [
    {
      "id": "button-icon-text-start",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon before label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Button",
        "iconStart": "sparkles"
      }
    },
    {
      "id": "button-icon-text-end",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon after label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Button",
        "iconEnd": "chevron.right"
      }
    },
    {
      "id": "button-icon",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon without label"
      ],
      "context": {
        "size": "medium",
        "type": "secondary",
        "iconStart": "gearshape",
        "ariaLabel": "Icon button"
      }
    },
    {
      "id": "button-text",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Text button"
      }
    },
    {
      "id": "button-loading",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "data-loading='true'",
        "caller-owned loading label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Working\u2026",
        "loading": true,
        "disabled": true
      }
    },
    {
      "id": "button-success",
      "sizes": [
        "small",
        "medium",
        "large"
      ],
      "types": [
        "primary",
        "secondary",
        "tertiary",
        "quaternary"
      ],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "data-state='success'",
        "caller-owned result label"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "state": "success",
        "label": "Completed",
        "iconStart": "checkmark",
        "disabled": true
      }
    },
    {
      "id": "button-save-ready",
      "title": "Save ready",
      "spec": ["data-type='primary'", "data-tone='save'", "caller-owned Save phase"],
      "context": { "size": "medium", "type": "primary", "tone": "save", "label": "Save" }
    },
    {
      "id": "button-save-pending",
      "title": "Save pending",
      "spec": ["data-tone='save'", "data-loading='true'", "disabled and aria-busy"],
      "context": {
        "size": "medium",
        "type": "primary",
        "tone": "save",
        "label": "Saving…",
        "loading": true,
        "disabled": true
      }
    },
    {
      "id": "button-save-complete",
      "title": "Save complete",
      "spec": ["data-tone='save'", "data-state='success'", "Spinner is decorative; not aria-busy"],
      "html": "<button class='diet-button' data-size='medium' data-type='primary' data-tone='save' data-state='success' type='button' disabled><span class='diet-spinner' aria-hidden='true'></span><span class='diet-button__label'>Saved</span></button>"
    },
    {
      "id": "button-republish-ready",
      "title": "Republish ready",
      "spec": ["data-type='primary'", "data-tone='republish'", "current Republish Icon"],
      "context": {
        "size": "medium",
        "type": "primary",
        "tone": "republish",
        "label": "Republish",
        "iconStart": "arrow.trianglehead.2.counterclockwise"
      }
    },
    {
      "id": "button-republish-pending",
      "title": "Republish pending",
      "spec": ["data-tone='republish'", "data-loading='true'", "disabled and aria-busy"],
      "context": {
        "size": "medium",
        "type": "primary",
        "tone": "republish",
        "label": "Republishing…",
        "loading": true,
        "disabled": true
      }
    },
    {
      "id": "button-republish-complete",
      "title": "Republish complete",
      "spec": ["data-tone='republish'", "data-state='success'", "caller-owned publication result"],
      "context": {
        "size": "medium",
        "type": "primary",
        "tone": "republish",
        "state": "success",
        "label": "Live widget updated",
        "iconStart": "checkmark",
        "disabled": true
      }
    }
  ]
}
