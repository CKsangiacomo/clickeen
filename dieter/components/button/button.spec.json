{
  "component": "button",
  "syntax": "<button class='diet-button' data-size='{{SIZE}}' data-type='{{TYPE}}'>…</button>",
  "attributes": {
    "size": { "enum": ["small", "medium", "large"], "required": true },
    "type": { "enum": ["primary", "secondary", "tertiary"], "required": true },
    "ariaLabel": { "optional": true },
    "label": { "optional": true },
    "icon": { "optional": true },
    "iconSize": { "enum": ["12", "16", "20", "24", "28", "32", "36", "40"], "optional": true },
    "tabIndex": { "optional": true },
    "disabled": { "optional": true },
    "path": { "optional": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "string" },
  "defaults": [
    {
      "id": "button-icon-text",
      "sizes": ["small", "medium", "large"],
      "types": ["primary", "secondary", "tertiary"],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon data-size='{{iconSize}}'"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Button",
        "icon": "sparkles",
        "iconSize": "16"
      },
      "sizeContext": {
        "small": { "iconSize": "12" },
        "medium": { "iconSize": "16" },
        "large": { "iconSize": "20" }
      }
    },
    {
      "id": "button-icon",
      "sizes": ["small", "medium", "large"],
      "types": ["primary", "secondary", "tertiary"],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'",
        "diet-icon data-size='{{iconSize}}'"
      ],
      "context": {
        "size": "medium",
        "type": "secondary",
        "icon": "gearshape",
        "iconSize": "16",
        "ariaLabel": "Icon button"
      },
      "sizeContext": {
        "small": { "iconSize": "12" },
        "medium": { "iconSize": "16" },
        "large": { "iconSize": "20" }
      }
    },
    {
      "id": "button-text",
      "sizes": ["small", "medium", "large"],
      "types": ["primary", "secondary", "tertiary"],
      "spec": [
        "diet-button",
        "data-size='{{size}}'",
        "data-type='{{type}}'"
      ],
      "context": {
        "size": "medium",
        "type": "primary",
        "label": "Text button"
      }
    }
  ]
}
