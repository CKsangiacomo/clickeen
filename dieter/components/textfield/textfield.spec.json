{
  "component": "textfield",
  "syntax": "<tooldrawer-field type='textfield' size='{{SIZE}}' path='{{PATH}}' label='{{LABEL}}' placeholder='{{PLACEHOLDER}}' value='{{VALUE}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "path": { "optional": true },
    "label": { "required": true },
    "placeholder": { "optional": true },
    "value": { "optional": true },
    "disabled": { "optional": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "string" },
  "defaults": [
    {
      "id": "textfield-sizes",
      "title": "Current value",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-textfield", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "id": "textfield-{{size}}",
        "label": "Label",
        "placeholder": "",
        "value": "Current value",
        "path": "",
        "disabled": false
      }
    },
    {
      "id": "textfield-placeholder",
      "title": "Empty with caller placeholder",
      "sizes": ["md"],
      "spec": ["diet-textfield", "data-size='md'", "empty value"],
      "context": {
        "size": "md",
        "id": "textfield-placeholder",
        "label": "Label",
        "placeholder": "Enter text",
        "value": "",
        "path": "",
        "disabled": false
      }
    },
    {
      "id": "textfield-disabled",
      "title": "Disabled",
      "sizes": ["md"],
      "spec": ["diet-textfield", "data-size='md'", "disabled"],
      "context": {
        "size": "md",
        "id": "textfield-disabled",
        "label": "Label",
        "placeholder": "",
        "value": "Unavailable",
        "path": "",
        "disabled": true
      }
    }
  ]
}
