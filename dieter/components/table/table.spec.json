{
  "component": "table",
  "syntax": "<div class='diet-table'><table class='diet-table__table'>…</table></div>",
  "attributes": {},
  "presentation": {
    "surface": "--role-surface",
    "headerSurface": "--role-surface-muted",
    "border": "none",
    "radius": "--control-radius-2xl",
    "elevation": "--shadow-floating",
    "cellPadding": "--space-3 / --space-4",
    "separatorSource": "--role-border",
    "previewWidth": "24%, minimum 8rem",
    "actionWidth": "content"
  },
  "defaults": [
    {
      "id": "ordinary",
      "title": "Ordinary",
      "spec": ["Semantic rows and columns"],
      "html": "<div class='diet-table' data-table-composition='ordinary'><table class='diet-table__table'><caption class='sr-only'>Ordinary content records</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "horizontal-overflow",
      "title": "Horizontal overflow",
      "spec": ["The table wrapper owns horizontal scrolling when space is constrained"],
      "html": "<div class='diet-table' data-table-composition='horizontal-overflow' style='max-inline-size: 24rem'><table class='diet-table__table'><caption class='sr-only'>Content records with horizontally overflowing columns</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th><th class='label-s' scope='col'>Owner</th><th class='label-s' scope='col'>Last updated</th><th class='label-s' scope='col'>Distribution channel</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Seasonal homepage announcement</th><td class='body-s'>Active</td><td class='body-s'>Merchandising team</td><td class='body-s'>30 July 2026</td><td class='body-s'>Website and storefront applications</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "row-action",
      "title": "Row action",
      "spec": ["Actions remain in the row they affect"],
      "html": "<div class='diet-table' data-table-composition='row-action'><table class='diet-table__table'><caption class='sr-only'>Content records with row actions</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th><th class='label-s diet-table__cell--action' scope='col'>Action</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td><td class='body-s diet-table__cell--action'><button class='diet-btn-txt' type='button' data-size='sm' data-variant='secondary'><span class='diet-btn-txt__label'>Edit</span></button></td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td><td class='body-s diet-table__cell--action'><button class='diet-btn-txt' type='button' data-size='sm' data-variant='secondary'><span class='diet-btn-txt__label'>Edit</span></button></td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "editable-cell",
      "title": "Editable cell",
      "spec": ["Inputs use the shared operational field inside table cells"],
      "html": "<div class='diet-table' data-table-composition='editable-cell'><table class='diet-table__table'><caption class='sr-only'>Content records with editable cells</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Value</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'><input class='diet-operational-field body-s' type='text' value='Free shipping' aria-label='Homepage notice value' /></td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'><input class='diet-operational-field body-s' type='text' value='Recommended for you' aria-label='Product recommendation value' /></td></tr></tbody></table></div>",
      "context": {}
    }
  ]
}
