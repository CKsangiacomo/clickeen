{
  "component": "table",
  "syntax": "<div class='diet-table'><table class='diet-table__table'>…</table></div>",
  "attributes": {},
  "presentation": {
    "surface": "--role-surface",
    "headerSurface": "--role-surface",
    "border": "none",
    "radius": "--control-radius-lg",
    "elevation": "none",
    "cellPadding": "--space-3 / --space-4",
    "headerSeparator": "--color-system-gray-step3",
    "bodySeparator": "--color-system-gray-step5",
    "inactiveSortIcon": "chevron.down.dotted.2 / --color-system-gray",
    "activeSortIcons": "chevron.up.2 or chevron.down.2 / --color-system-black",
    "previewWidth": "24%, minimum 8rem",
    "actionWidth": "content"
  },
  "defaults": [
    {
      "id": "ordinary",
      "title": "Ordinary",
      "spec": ["Semantic rows and columns"],
      "html": "<div class='diet-table' data-table-composition='ordinary'><table class='diet-table__table'><caption class='sr-only'>Ordinary content records</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "sortable-ascending",
      "title": "Sortable columns — ascending",
      "spec": ["The app owns sort state; Table owns the shared icon treatment"],
      "html": "<div class='diet-table' data-table-composition='sortable-ascending'><table class='diet-table__table'><caption class='sr-only'>Sortable content records</caption><thead><tr><th class='label-s' scope='col' aria-sort='ascending'><span>Name</span> <button class='diet-button' data-size='small' data-type='quaternary' type='button' aria-label='Sort by name'><span class='diet-icon' data-size='12' data-icon='chevron.up.2' aria-hidden='true'></span></button></th><th class='label-s' scope='col' aria-sort='none'><span>Status</span> <button class='diet-button' data-size='small' data-type='quaternary' type='button' aria-label='Sort by status'><span class='diet-icon' data-size='12' data-icon='chevron.down.dotted.2' aria-hidden='true'></span></button></th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "sortable-descending",
      "title": "Sortable columns — descending",
      "spec": ["The active descending column uses its exact direction icon"],
      "html": "<div class='diet-table' data-table-composition='sortable-descending'><table class='diet-table__table'><caption class='sr-only'>Sortable descending content records</caption><thead><tr><th class='label-s' scope='col' aria-sort='none'><span>Name</span> <button class='diet-button' data-size='small' data-type='quaternary' type='button' aria-label='Sort by name'><span class='diet-icon' data-size='12' data-icon='chevron.down.dotted.2' aria-hidden='true'></span></button></th><th class='label-s' scope='col' aria-sort='descending'><span>Status</span> <button class='diet-button' data-size='small' data-type='quaternary' type='button' aria-label='Sort by status'><span class='diet-icon' data-size='12' data-icon='chevron.down.2' aria-hidden='true'></span></button></th></tr></thead><tbody><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td></tr><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "horizontal-overflow",
      "title": "Horizontal overflow",
      "spec": ["The table wrapper owns horizontal scrolling when space is constrained"],
      "html": "<div class='diet-table' data-table-composition='horizontal-overflow' style='max-inline-size: 24rem'><table class='diet-table__table'><caption class='sr-only'>Content records with horizontally overflowing columns</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th><th class='label-s' scope='col'>Owner</th><th class='label-s' scope='col'>Last updated</th><th class='label-s' scope='col'>Distribution channel</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Seasonal homepage announcement</th><td class='body-s'>Active</td><td class='body-s'>Merchandising team</td><td class='body-s'>30 July 2026</td><td class='body-s'>Website and storefront applications</td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "row-action",
      "title": "Row action",
      "spec": ["Actions remain in the row they affect"],
      "html": "<div class='diet-table' data-table-composition='row-action'><table class='diet-table__table'><caption class='sr-only'>Content records with row actions</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Status</th><th class='label-s diet-table__cell--action' scope='col'>Action</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'>Active</td><td class='body-s diet-table__cell--action'><button class='diet-button' type='button' data-size='small' data-type='secondary'><span class='diet-button__label'>Edit</span></button></td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'>Draft</td><td class='body-s diet-table__cell--action'><button class='diet-button' type='button' data-size='small' data-type='secondary'><span class='diet-button__label'>Edit</span></button></td></tr></tbody></table></div>",
      "context": {}
    },
    {
      "id": "editable-cell",
      "title": "Editable cell",
      "spec": ["Editable values use Dieter Textfield inside table cells"],
      "html": "<div class='diet-table' data-table-composition='editable-cell'><table class='diet-table__table'><caption class='sr-only'>Content records with editable cells</caption><thead><tr><th class='label-s' scope='col'>Name</th><th class='label-s' scope='col'>Value</th></tr></thead><tbody><tr><th class='body-s' scope='row'>Homepage notice</th><td class='body-s'><div class='diet-textfield' data-size='sm'><label class='diet-textfield__control'><span class='diet-textfield__display-label is-hidden'>Homepage notice value</span><input class='diet-textfield__field' type='text' value='Free shipping' aria-label='Homepage notice value' /></label></div></td></tr><tr><th class='body-s' scope='row'>Product recommendation</th><td class='body-s'><div class='diet-textfield' data-size='sm'><label class='diet-textfield__control'><span class='diet-textfield__display-label is-hidden'>Product recommendation value</span><input class='diet-textfield__field' type='text' value='Recommended for you' aria-label='Product recommendation value' /></label></div></td></tr></tbody></table></div>",
      "context": {}
    }
  ]
}
