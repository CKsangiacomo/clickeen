{
  "component": "menuactions",
  "description": "Consumer-agnostic action row for menus and Popovers.",
  "syntax": "<button class='diet-btn-menuactions' data-size='{{SIZE}}'>…</button>",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "required": true },
    "label": { "required": true },
    "icon": { "optional": true },
    "disabled": { "optional": true }
  },
  "previews": [
    {
      "id": "menuactions-label",
      "title": "Label only",
      "sizes": ["sm", "md", "lg"],
      "spec": [
        "diet-btn-menuactions",
        "data-size='{{size}}'"
      ],
      "context": {
        "size": "sm",
        "label": "Rename"
      }
    },
    {
      "id": "menuactions-trailing-icon",
      "title": "Trailing Icon",
      "sizes": ["sm", "md", "lg"],
      "spec": [
        "diet-btn-menuactions",
        "data-size='{{size}}'",
        "trailing diet-icon"
      ],
      "context": {
        "size": "sm",
        "label": "Selected option",
        "icon": "checkmark"
      }
    },
    {
      "id": "menuactions-disabled",
      "title": "Disabled",
      "sizes": ["sm", "md", "lg"],
      "spec": [
        "diet-btn-menuactions",
        "data-size='{{size}}'",
        "disabled"
      ],
      "context": {
        "size": "sm",
        "label": "Unavailable action",
        "disabled": true
      }
    }
  ]
}
