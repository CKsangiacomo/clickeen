{
  "component": "dropdown-shadow",
  "syntax": "<tooldrawer-field type='dropdown-shadow' size='{{SIZE}}' popover-width='{{POPOVER_WIDTH}}' path='{{PATH}}' label='{{LABEL}}' value='{{VALUE}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "popoverWidth": { "enum": ["row", "wide", "extra-wide"], "default": "wide" },
    "path": { "optional": true },
    "label": { "required": true },
    "axis": { "enum": ["x", "y", "both"], "default": "both" },
    "value": { "required": true },
    "enabledLabel": { "required": true },
    "horizontalLabel": { "required": true },
    "verticalLabel": { "required": true },
    "blurLabel": { "required": true },
    "spreadLabel": { "required": true },
    "opacityLabel": { "required": true },
    "colorLabel": { "required": true },
    "hueLabel": { "required": true },
    "hexLabel": { "required": true },
    "defaultColorsLabel": { "required": true },
    "previewLabel": { "required": true }
  },
  "binding": { "path": "instanceData[PATH]", "type": "json" },
  "defaults": [
    {
      "id": "dropdown-shadow",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-dropdown-shadow", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "popoverWidth": "wide",
        "state": "closed",
        "expanded": "false",
        "id": "dropdown-shadow-{{size}}",
        "label": "Shadow",
        "axis": "both",
        "value": "{\"enabled\":true,\"inset\":false,\"x\":0,\"y\":8,\"blur\":24,\"spread\":0,\"color\":\"#212121\",\"alpha\":18}",
        "enabledLabel": "Enabled",
        "horizontalLabel": "Horizontal",
        "verticalLabel": "Vertical",
        "blurLabel": "Blur",
        "spreadLabel": "Spread",
        "opacityLabel": "Opacity",
        "colorLabel": "Color",
        "hueLabel": "Hue",
        "hexLabel": "Hex",
        "defaultColorsLabel": "Default colors",
        "previewLabel": "Shadow preview"
      },
      "sizeContext": {
        "sm": { "value": "{\"enabled\":true,\"inset\":false,\"x\":0,\"y\":4,\"blur\":12,\"spread\":0,\"color\":\"#212121\",\"alpha\":20}" },
        "md": { "value": "{\"enabled\":true,\"inset\":false,\"x\":0,\"y\":8,\"blur\":24,\"spread\":0,\"color\":\"#212121\",\"alpha\":18}" },
        "lg": { "value": "{\"enabled\":false,\"inset\":false,\"x\":0,\"y\":12,\"blur\":32,\"spread\":0,\"color\":\"#212121\",\"alpha\":20}" }
      }
    },
    {
      "id": "dropdown-shadow-open",
      "title": "Open outside shadow",
      "sizes": ["md"],
      "spec": ["diet-dropdown-shadow", "popover-width='wide'", "data-state='open'"],
      "context": {
        "size": "md", "popoverWidth": "wide", "state": "open", "expanded": "true", "id": "dropdown-shadow-open", "label": "Shadow", "axis": "both", "value": "{\"enabled\":true,\"inset\":false,\"x\":8,\"y\":12,\"blur\":24,\"spread\":0,\"color\":\"#212121\",\"alpha\":24}", "enabledLabel": "Enabled", "horizontalLabel": "Horizontal", "verticalLabel": "Vertical", "blurLabel": "Blur", "spreadLabel": "Spread", "opacityLabel": "Opacity", "colorLabel": "Color", "hueLabel": "Hue", "hexLabel": "Hex", "defaultColorsLabel": "Default colors", "previewLabel": "Shadow preview"
      }
    },
    {
      "id": "dropdown-shadow-inset",
      "title": "Open inset shadow",
      "sizes": ["md"],
      "spec": ["diet-dropdown-shadow", "data-state='open'", "inset value"],
      "context": {
        "size": "md", "popoverWidth": "wide", "state": "open", "expanded": "true", "id": "dropdown-shadow-inset", "label": "Inside shadow", "axis": "both", "value": "{\"enabled\":true,\"inset\":true,\"x\":0,\"y\":6,\"blur\":18,\"spread\":0,\"color\":\"#5856d6\",\"alpha\":30}", "enabledLabel": "Enabled", "horizontalLabel": "Horizontal", "verticalLabel": "Vertical", "blurLabel": "Blur", "spreadLabel": "Spread", "opacityLabel": "Opacity", "colorLabel": "Color", "hueLabel": "Hue", "hexLabel": "Hex", "defaultColorsLabel": "Default colors", "previewLabel": "Shadow preview"
      }
    },
    {
      "id": "dropdown-shadow-horizontal",
      "title": "Open horizontal axis",
      "sizes": ["md"],
      "spec": ["diet-dropdown-shadow", "axis='x'", "data-state='open'"],
      "context": {
        "size": "md", "popoverWidth": "wide", "state": "open", "expanded": "true", "id": "dropdown-shadow-horizontal", "label": "Horizontal shadow", "axis": "x", "value": "{\"enabled\":true,\"inset\":true,\"x\":8,\"y\":0,\"blur\":20,\"spread\":0,\"color\":\"#212121\",\"alpha\":22}", "enabledLabel": "Enabled", "horizontalLabel": "Horizontal", "verticalLabel": "Vertical", "blurLabel": "Blur", "spreadLabel": "Spread", "opacityLabel": "Opacity", "colorLabel": "Color", "hueLabel": "Hue", "hexLabel": "Hex", "defaultColorsLabel": "Default colors", "previewLabel": "Shadow preview"
      }
    },
    {
      "id": "dropdown-shadow-vertical",
      "title": "Open vertical axis",
      "sizes": ["md"],
      "spec": ["diet-dropdown-shadow", "axis='y'", "data-state='open'"],
      "context": {
        "size": "md", "popoverWidth": "wide", "state": "open", "expanded": "true", "id": "dropdown-shadow-vertical", "label": "Vertical shadow", "axis": "y", "value": "{\"enabled\":true,\"inset\":true,\"x\":0,\"y\":8,\"blur\":20,\"spread\":0,\"color\":\"#212121\",\"alpha\":22}", "enabledLabel": "Enabled", "horizontalLabel": "Horizontal", "verticalLabel": "Vertical", "blurLabel": "Blur", "spreadLabel": "Spread", "opacityLabel": "Opacity", "colorLabel": "Color", "hueLabel": "Hue", "hexLabel": "Hex", "defaultColorsLabel": "Default colors", "previewLabel": "Shadow preview"
      }
    },
    {
      "id": "dropdown-shadow-disabled",
      "title": "Open disabled shadow",
      "sizes": ["md"],
      "spec": ["diet-dropdown-shadow", "data-state='open'", "disabled dependent body"],
      "context": {
        "size": "md", "popoverWidth": "wide", "state": "open", "expanded": "true", "id": "dropdown-shadow-disabled", "label": "Shadow", "axis": "both", "value": "{\"enabled\":false,\"inset\":false,\"x\":0,\"y\":8,\"blur\":24,\"spread\":0,\"color\":\"#212121\",\"alpha\":18}", "enabledLabel": "Enabled", "horizontalLabel": "Horizontal", "verticalLabel": "Vertical", "blurLabel": "Blur", "spreadLabel": "Spread", "opacityLabel": "Opacity", "colorLabel": "Color", "hueLabel": "Hue", "hexLabel": "Hex", "defaultColorsLabel": "Default colors", "previewLabel": "Shadow preview"
      }
    }
  ]
}
