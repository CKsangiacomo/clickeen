{
  "component": "choice-tiles",
  "description": "Two/three option tile picker built from Dieter buttons and a bound hidden input. Choice Tiles owns proportional tile geometry while callers own all labels and optional icons.",
  "syntax": "<tooldrawer-field type='choice-tiles' size='{{SIZE}}' path='{{PATH}}' label='{{LABEL}}' options='{{OPTIONS}}' value='{{VALUE}}' />",
  "attributes": {
    "size": { "enum": ["sm", "md", "lg"], "default": "md" },
    "path": { "optional": true },
    "label": { "optional": true },
    "value": { "optional": true },
    "options": { "optional": false }
  },
  "binding": { "path": "instanceData[PATH]", "type": "string" },
  "defaults": [
    {
      "id": "choice-tiles-with-icons",
      "sizes": ["sm", "md", "lg"],
      "spec": ["diet-choice-tiles", "data-size='{{size}}'"],
      "context": {
        "size": "md",
        "buttonSize": "medium",
        "id": "choice-tiles-with-icons-{{size}}",
        "label": "Layout",
        "value": "accordion",
        "path": "",
        "options": [
          { "label": "Accordion", "value": "accordion", "icon": "chevron.down.2", "selected": true },
          { "label": "List", "value": "list", "icon": "square.stack.3d.up" },
          { "label": "Cards", "value": "multicolumn", "icon": "circle.grid.2x2" }
        ]
      },
      "sizeContext": {
        "sm": { "buttonSize": "small" },
        "md": { "buttonSize": "medium" },
        "lg": { "buttonSize": "large" }
      }
    },
    {
      "id": "choice-tiles-without-icons",
      "sizes": ["md"],
      "spec": ["diet-choice-tiles", "data-size='{{size}}'", "two options without icons"],
      "context": {
        "size": "md",
        "buttonSize": "medium",
        "id": "choice-tiles-without-icons-{{size}}",
        "label": "Statement alignment",
        "value": "left",
        "path": "",
        "options": [
          { "label": "Left", "value": "left", "selected": true },
          { "label": "Center", "value": "center" }
        ]
      },
      "sizeContext": {
        "md": { "buttonSize": "medium" }
      }
    }
  ]
}
