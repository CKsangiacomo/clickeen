{
  "layout": "main-container",
  "source": {
    "html": "main-container.html",
    "css": "main-container.css"
  },
  "taxonomy": {
    "root": "main-container",
    "directChildren": ["left-nav", "page"],
    "pageParts": ["page__header", "page__actions", "page__content"]
  },
  "state": {
    "navigationOpen": {
      "attribute": "data-navigation-open",
      "openValue": "true",
      "scrim": "[data-navigation-scrim]",
      "owner": "consumer"
    }
  },
  "presentation": {
    "inset": "--space-2",
    "surface": "--role-surface-muted",
    "border": "--role-border",
    "radius": "--control-radius-2xl",
    "wideElevation": "--shadow-floating",
    "compactElevation": "--shadow-elevated",
    "compactQuery": "(max-width: 599px), (max-height: 599px)"
  },
  "editableTokens": [
    "--layout-left-nav-width",
    "--layout-left-nav-padding",
    "--layout-page-padding",
    "--layout-compact-left-nav-width"
  ],
  "examples": [
    {
      "id": "full",
      "label": "Full"
    },
    {
      "id": "compact-closed",
      "label": "Compact closed"
    },
    {
      "id": "compact-open",
      "label": "Compact open",
      "attributes": {
        "data-navigation-open": "true"
      }
    }
  ]
}
