{
  "layout": "main-container",
  "source": {
    "html": "main-container.html",
    "css": "main-container.css"
  },
  "taxonomy": {
    "root": "main-container",
    "directChildren": ["left-nav", "page"],
    "pageParts": ["page__header", "page__heading", "page__actions", "page__content"],
    "pageHeaderDirectChildren": ["page__heading", "page__actions"]
  },
  "width": {
    "attribute": "data-width",
    "values": ["contained", "full"],
    "contained": {
      "maxInlineSize": "80rem",
      "marginInline": "auto"
    },
    "full": {
      "maxInlineSize": "none",
      "marginInline": "0",
      "paddingInline": "var(--layout-page-padding)"
    }
  },
  "state": {
    "navigationOpen": {
      "attribute": "data-navigation-open",
      "openValue": "true",
      "scrim": "[data-navigation-scrim]",
      "owner": "consumer"
    }
  },
  "presentation": {
    "inset": "var(--space-2)",
    "canvas": "var(--role-surface-muted)",
    "navigationSurface": "var(--role-surface)",
    "border": "none",
    "radius": "var(--control-radius-3xl)",
    "widePanelWidth": "var(--layout-left-nav-width)",
    "compactPanelWidth": "min(var(--layout-compact-left-nav-width), calc(100vw - var(--space-4)))",
    "wideElevation": "var(--shadow-floating)",
    "compactElevation": "var(--shadow-elevated)",
    "pageContentMaxWidth": "80rem",
    "widePageRhythm": "--layout-page-padding / --space-4 / --space-4",
    "compactPageRhythm": "--space-4 / --space-3 / --space-3",
    "compactQuery": "(max-width: 599px), (max-height: 599px)"
  },
  "editableTokens": [
    "--layout-left-nav-width",
    "--layout-left-nav-padding",
    "--layout-page-padding",
    "--layout-compact-left-nav-width"
  ]
}
