{
  "widgetname": "calltoaction",
  "displayName": "Call to Action",
  "description": "",
  "defaults": {
    "uiLabels": {
      "core": {
        "singular": "$label:core.singular",
        "plural": "$label:core.plural",
        "sizeCluster": "$label:core.size-cluster"
      }
    },
    "typography": {
      "roles": {
        "eyebrow": {
          "color": {
            "type": "color",
            "color": "var(--color-system-gray)"
          },
          "family": "Inter",
          "weight": "700",
          "fontStyle": "normal",
          "sizeCustom": 13,
          "sizePreset": "custom",
          "trackingCustom": 0,
          "trackingPreset": "normal",
          "lineHeightCustom": 1.2,
          "lineHeightPreset": "custom"
        }
      },
      "roleScales": {
        "eyebrow": {
          "l": "16px",
          "m": "13px",
          "s": "12px",
          "xl": "18px",
          "xs": "11px"
        }
      }
    },
    "calltoaction": {
      "showEyebrow": false,
      "eyebrow": "Launch-ready widget",
      "headline": "Build your next section in minutes",
      "showSupportingText": true,
      "supportingTextHtml": "Start with a polished Clickeen widget, customize it in Builder, and publish it anywhere your site needs it.",
      "action": {
        "enabled": true,
        "label": "Get started",
        "href": "#",
        "openMode": "same-tab",
        "iconEnabled": true,
        "iconName": "arrowshape.turn.up.right",
        "iconPlacement": "right"
      },
      "layout": {
        "alignment": "center",
        "gap": 18,
        "textWidth": 760
      },
      "actionStyle": {
        "background": {
          "type": "color",
          "color": "var(--color-system-blue)"
        },
        "textColor": {
          "type": "color",
          "color": "var(--color-system-white)"
        },
        "border": {
          "enabled": false,
          "width": 1,
          "color": "transparent"
        },
        "radius": "lg",
        "paddingInline": 18,
        "paddingBlock": 12,
        "iconSize": 16
      }
    }
  },
  "editor": {
    "labels": {
      "components": {
        "agent-activity": {
          "title": "$label:component.agent-activity.title"
        },
        "dropdown-border": {
          "color": "$label:component.dropdown-border.color.label",
          "defaultColors": "$label:component.dropdown-border.default-colors.label",
          "enabled": "$label:component.dropdown-border.enabled.label",
          "hex": "$label:component.dropdown-border.hex.label",
          "hue": "$label:component.dropdown-border.hue.label",
          "width": "$label:component.dropdown-border.width.label"
        },
        "dropdown-edit": {
          "addLink": "$label:component.dropdown-edit.add-link.label",
          "bold": "$label:component.dropdown-edit.bold.label",
          "clearFormatting": "$label:component.dropdown-edit.clear-formatting.label",
          "italic": "$label:component.dropdown-edit.italic.label",
          "link": "$label:component.dropdown-edit.link.label",
          "removeLink": "$label:component.dropdown-edit.remove-link.label",
          "strikethrough": "$label:component.dropdown-edit.strikethrough.label",
          "underline": "$label:component.dropdown-edit.underline.label",
          "url": "$label:component.dropdown-edit.url.label"
        }
      },
      "fields": {
        "dropdown-border": {
          "appearance.headerCta.border": "$label:appearance.header-cta.border.dropdown-border.label",
          "appearance.localeSwitcherBorder": "$label:appearance.locale-switcher.border.dropdown-border.label",
          "appearance.podBorder": "$label:appearance.pod-border.dropdown-border.label"
        }
      }
    },
    "panels": [
      {
        "id": "content",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-content"
          },
          {
            "label": "$label:content.cluster.content.label",
            "initiallyOpen": true,
            "nodes": [
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "toggle",
                "path": "calltoaction.showEyebrow",
                "label": "$label:content.field.calltoaction.show-eyebrow.toggle.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "textfield",
                "path": "calltoaction.eyebrow",
                "label": "$label:content.field.calltoaction.eyebrow.textfield.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "placeholder": "$label:content.field.calltoaction.eyebrow.textfield.attr.placeholder"
                },
                "showIf": {
                  "path": "calltoaction.showEyebrow",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "dropdown-edit",
                "path": "calltoaction.headline",
                "label": "$label:content.field.calltoaction.headline.dropdown-edit.label",
                "attrs": {
                  "group-label": "",
                  "size": "lg",
                  "placeholder": "$label:content.field.calltoaction.headline.dropdown-edit.attr.placeholder"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "toggle",
                "path": "calltoaction.showSupportingText",
                "label": "$label:content.field.calltoaction.show-supporting-text.toggle.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "dropdown-edit",
                "path": "calltoaction.supportingTextHtml",
                "label": "$label:content.field.calltoaction.supporting-text-html.dropdown-edit.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "placeholder": "$label:content.field.calltoaction.supporting-text-html.dropdown-edit.attr.placeholder"
                },
                "showIf": {
                  "path": "calltoaction.showSupportingText",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "toggle",
                "path": "calltoaction.action.enabled",
                "label": "$label:content.field.calltoaction.action.enabled.toggle.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "textfield",
                "path": "calltoaction.action.label",
                "label": "$label:content.field.calltoaction.action.label.textfield.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "textfield",
                "path": "calltoaction.action.href",
                "label": "$label:content.field.calltoaction.action.href.textfield.label",
                "attrs": {
                  "group-label": "",
                  "size": "lg",
                  "placeholder": "$label:content.field.calltoaction.action.href.textfield.attr.placeholder"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "dropdown-actions",
                "path": "calltoaction.action.openMode",
                "label": "$label:content.field.calltoaction.action.open-mode.dropdown-actions.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:content.field.calltoaction.action.open-mode.dropdown-actions.option.same-tab.label",
                      "value": "same-tab"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.open-mode.dropdown-actions.option.new-tab.label",
                      "value": "new-tab"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.open-mode.dropdown-actions.option.new-window.label",
                      "value": "new-window"
                    }
                  ]
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "toggle",
                "path": "calltoaction.action.iconEnabled",
                "label": "$label:content.field.calltoaction.action.icon-enabled.toggle.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "dropdown-actions",
                "path": "calltoaction.action.iconPlacement",
                "label": "$label:content.field.calltoaction.action.icon-placement.dropdown-actions.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:content.field.calltoaction.action.icon-placement.dropdown-actions.option.left.label",
                      "value": "left"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.icon-placement.dropdown-actions.option.right.label",
                      "value": "right"
                    }
                  ]
                },
                "showIf": {
                  "all": [
                    {
                      "path": "calltoaction.action.enabled",
                      "op": "isTrue"
                    },
                    {
                      "path": "calltoaction.action.iconEnabled",
                      "op": "isTrue"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-content",
                "type": "dropdown-actions",
                "path": "calltoaction.action.iconName",
                "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.option.checkmark.label",
                      "value": "checkmark"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.option.arrow.right.label",
                      "value": "arrow.right"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.option.chevron.right.label",
                      "value": "chevron.right"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.option.arrowshape.forward.label",
                      "value": "arrowshape.forward"
                    },
                    {
                      "label": "$label:content.field.calltoaction.action.icon-name.dropdown-actions.option.arrowshape.turn.up.right.label",
                      "value": "arrowshape.turn.up.right"
                    }
                  ]
                },
                "showIf": {
                  "all": [
                    {
                      "path": "calltoaction.action.enabled",
                      "op": "isTrue"
                    },
                    {
                      "path": "calltoaction.action.iconEnabled",
                      "op": "isTrue"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "id": "typography",
        "shared": {
          "id": "typography",
          "roleLabels": {
            "body": "$label:typography.role.body.label",
            "eyebrow": "$label:typography.role.eyebrow.label",
            "title": "$label:typography.role.title.label"
          }
        }
      },
      {
        "id": "layout",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-layout"
          },
          {
            "kind": "shared",
            "id": "core-size"
          },
          {
            "label": "$label:layout.cluster.call-to-action-layout.label",
            "nodes": [
              {
                "kind": "field",
                "groupId": "calltoaction-layout",
                "type": "choice-tiles",
                "path": "calltoaction.layout.alignment",
                "label": "$label:layout.field.calltoaction.layout.alignment.choice-tiles.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.calltoaction.layout.alignment.choice-tiles.option.left.label",
                      "value": "left"
                    },
                    {
                      "label": "$label:layout.field.calltoaction.layout.alignment.choice-tiles.option.center.label",
                      "value": "center"
                    },
                    {
                      "label": "$label:layout.field.calltoaction.layout.alignment.choice-tiles.option.right.label",
                      "value": "right"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-layout",
                "type": "valuefield",
                "path": "calltoaction.layout.textWidth",
                "label": "$label:layout.field.calltoaction.layout.text-width.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "min": 280,
                  "max": 1200,
                  "step": 10
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-layout",
                "type": "valuefield",
                "path": "calltoaction.layout.gap",
                "label": "$label:layout.field.calltoaction.layout.gap.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "min": 0,
                  "max": 80,
                  "step": 1
                }
              }
            ]
          },
          {
            "kind": "shared",
            "id": "stagepod-layout"
          }
        ]
      },
      {
        "id": "appearance",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-appearance"
          },
          {
            "label": "$label:appearance.cluster.action-button.label",
            "nodes": [
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "dropdown-fill",
                "path": "calltoaction.actionStyle.background",
                "label": "$label:appearance.field.calltoaction.action-style.background.dropdown-fill.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "fill-modes": "color",
                  "allow-color": "true"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "dropdown-fill",
                "path": "calltoaction.actionStyle.textColor",
                "label": "$label:appearance.field.calltoaction.action-style.text-color.dropdown-fill.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "fill-modes": "color",
                  "allow-color": "true"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "dropdown-border",
                "path": "calltoaction.actionStyle.border",
                "label": "$label:appearance.field.calltoaction.action-style.border.dropdown-border.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "dropdown-actions",
                "path": "calltoaction.actionStyle.radius",
                "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.none.label",
                      "value": "none"
                    },
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.sm.label",
                      "value": "sm"
                    },
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.md.label",
                      "value": "md"
                    },
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.lg.label",
                      "value": "lg"
                    },
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.xl.label",
                      "value": "xl"
                    },
                    {
                      "label": "$label:appearance.field.calltoaction.action-style.radius.dropdown-actions.option.2xl.label",
                      "value": "2xl"
                    }
                  ]
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "valuefield",
                "path": "calltoaction.actionStyle.paddingInline",
                "label": "$label:appearance.field.calltoaction.action-style.padding-inline.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "min": 8,
                  "max": 48,
                  "step": 1
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "valuefield",
                "path": "calltoaction.actionStyle.paddingBlock",
                "label": "$label:appearance.field.calltoaction.action-style.padding-block.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "min": 6,
                  "max": 36,
                  "step": 1
                },
                "showIf": {
                  "path": "calltoaction.action.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "groupId": "calltoaction-action",
                "type": "valuefield",
                "path": "calltoaction.actionStyle.iconSize",
                "label": "$label:appearance.field.calltoaction.action-style.icon-size.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "min": 10,
                  "max": 40,
                  "step": 1
                },
                "showIf": {
                  "all": [
                    {
                      "path": "calltoaction.action.enabled",
                      "op": "isTrue"
                    },
                    {
                      "path": "calltoaction.action.iconEnabled",
                      "op": "isTrue"
                    }
                  ]
                }
              }
            ]
          },
          {
            "kind": "shared",
            "id": "stagepod-appearance"
          }
        ]
      },
      {
        "id": "settings",
        "clusters": [
          {
            "kind": "shared",
            "id": "settings-behavior"
          }
        ]
      }
    ]
  }
}
