{
  "widgetname": "big-bang",
  "displayName": "Big Bang",
  "description": "",
  "defaults": {
    "uiLabels": {
      "core": {
        "singular": "$label:core.singular",
        "plural": "$label:core.plural",
        "sizeCluster": "$label:core.size-cluster"
      }
    },
    "typography": {
      "roles": {
        "bigBang": {
          "color": {
            "type": "color",
            "color": "var(--color-system-black)"
          },
          "family": "Inter",
          "weight": "800",
          "fontStyle": "normal",
          "sizeCustom": 84,
          "sizePreset": "custom",
          "trackingCustom": 0,
          "trackingPreset": "normal",
          "lineHeightCustom": 0.94,
          "lineHeightPreset": "custom"
        }
      },
      "roleScales": {
        "bigBang": {
          "l": "104px",
          "m": "84px",
          "s": "64px",
          "xl": "128px",
          "xs": "48px"
        }
      }
    },
    "bigBang": {
      "statement": "Make the important message impossible to miss.",
      "showSupportingCopy": true,
      "supportingCopy": "Use a Big Bang section when a page needs one bold statement with enough rhythm to stop the scroll.",
      "alignment": "left",
      "textWidth": 880,
      "gap": 24
    }
  },
  "editor": {
    "labels": {
      "components": {
        "agent-activity": {
          "title": "$label:component.agent-activity.title"
        },
        "dropdown-border": {
          "color": "$label:component.dropdown-border.color.label",
          "defaultColors": "$label:component.dropdown-border.default-colors.label",
          "enabled": "$label:component.dropdown-border.enabled.label",
          "hex": "$label:component.dropdown-border.hex.label",
          "hue": "$label:component.dropdown-border.hue.label",
          "width": "$label:component.dropdown-border.width.label"
        },
        "dropdown-edit": {
          "addLink": "$label:component.dropdown-edit.add-link.label",
          "bold": "$label:component.dropdown-edit.bold.label",
          "clearFormatting": "$label:component.dropdown-edit.clear-formatting.label",
          "italic": "$label:component.dropdown-edit.italic.label",
          "link": "$label:component.dropdown-edit.link.label",
          "removeLink": "$label:component.dropdown-edit.remove-link.label",
          "strikethrough": "$label:component.dropdown-edit.strikethrough.label",
          "underline": "$label:component.dropdown-edit.underline.label",
          "url": "$label:component.dropdown-edit.url.label"
        },
        "dropdown-shadow": {
          "aboveContent": "$label:component.dropdown-shadow.above-content.label",
          "belowContent": "$label:component.dropdown-shadow.below-content.label",
          "blur": "$label:component.dropdown-shadow.blur.label",
          "color": "$label:component.dropdown-shadow.color.label",
          "defaultColors": "$label:component.dropdown-shadow.default-colors.label",
          "enabled": "$label:component.dropdown-shadow.enabled.label",
          "hex": "$label:component.dropdown-shadow.hex.label",
          "horizontal": "$label:component.dropdown-shadow.horizontal.label",
          "hue": "$label:component.dropdown-shadow.hue.label",
          "layer": "$label:component.dropdown-shadow.layer.label",
          "opacity": "$label:component.dropdown-shadow.opacity.label",
          "preview": "$label:component.dropdown-shadow.preview.label",
          "spread": "$label:component.dropdown-shadow.spread.label",
          "vertical": "$label:component.dropdown-shadow.vertical.label"
        },
        "dropdown-fill": {
          "addGradientStop": "$label:component.dropdown-fill.add-gradient-stop.label",
          "angle": "$label:component.dropdown-fill.angle.label",
          "chooseAssets": "$label:component.dropdown-fill.choose-assets.label",
          "color": "$label:component.dropdown-fill.color.label",
          "colorFill": "$label:component.dropdown-fill.color-fill.label",
          "defaultColors": "$label:component.dropdown-fill.default-colors.label",
          "editGradientStop": "$label:component.dropdown-fill.edit-gradient-stop.label",
          "gradientFill": "$label:component.dropdown-fill.gradient-fill.label",
          "gradientStops": "$label:component.dropdown-fill.gradient-stops.label",
          "hex": "$label:component.dropdown-fill.hex.label",
          "hue": "$label:component.dropdown-fill.hue.label",
          "imageFill": "$label:component.dropdown-fill.image-fill.label",
          "loadAssetsError": "$label:component.dropdown-fill.load-assets-error.label",
          "loadingAssets": "$label:component.dropdown-fill.loading-assets.label",
          "noAssets": "$label:component.dropdown-fill.no-assets.label",
          "opacity": "$label:component.dropdown-fill.opacity.label",
          "previewAssetError": "$label:component.dropdown-fill.preview-asset-error.label",
          "removeAsset": "$label:component.dropdown-fill.remove-asset.label",
          "enabled": "$label:component.dropdown-fill.enabled.label",
          "removeGradientStop": "$label:component.dropdown-fill.remove-gradient-stop.label",
          "upload": "$label:component.dropdown-fill.upload.label",
          "uploadAssetError": "$label:component.dropdown-fill.upload-asset-error.label",
          "useAsset": "$label:component.dropdown-fill.use-asset.label",
          "videoFill": "$label:component.dropdown-fill.video-fill.label"
        }
      },
      "fields": {
        "dropdown-shadow": {
          "pod.insideShadow.all": "$label:appearance.pod.inside-shadow.all.dropdown-shadow.label",
          "pod.insideShadow.bottom": "$label:appearance.pod.inside-shadow.bottom.dropdown-shadow.label",
          "pod.insideShadow.left": "$label:appearance.pod.inside-shadow.left.dropdown-shadow.label",
          "pod.insideShadow.linked": "$label:appearance.pod.inside-shadow.linked.toggle.label",
          "pod.insideShadow.right": "$label:appearance.pod.inside-shadow.right.dropdown-shadow.label",
          "pod.insideShadow.top": "$label:appearance.pod.inside-shadow.top.dropdown-shadow.label",
          "pod.shadow": "$label:appearance.pod.shadow.dropdown-shadow.label",
          "stage.insideShadow.all": "$label:appearance.stage.inside-shadow.all.dropdown-shadow.label",
          "stage.insideShadow.bottom": "$label:appearance.stage.inside-shadow.bottom.dropdown-shadow.label",
          "stage.insideShadow.left": "$label:appearance.stage.inside-shadow.left.dropdown-shadow.label",
          "stage.insideShadow.linked": "$label:appearance.stage.inside-shadow.linked.toggle.label",
          "stage.insideShadow.right": "$label:appearance.stage.inside-shadow.right.dropdown-shadow.label",
          "stage.insideShadow.top": "$label:appearance.stage.inside-shadow.top.dropdown-shadow.label",
          "stage.shadow": "$label:appearance.stage.shadow.dropdown-shadow.label"
        },
        "dropdown-fill": {
          "appearance.headerCta.background": "$label:appearance.header-cta.background.dropdown-fill.label",
          "appearance.headerCta.textColor": "$label:appearance.header-cta.text-color.dropdown-fill.label",
          "appearance.localeSwitcherBackground": "$label:appearance.locale-switcher.background.dropdown-fill.label",
          "appearance.localeSwitcherTextColor": "$label:appearance.locale-switcher.text-color.dropdown-fill.label",
          "pod.background": "$label:appearance.pod.background.dropdown-fill.label",
          "stage.background": "$label:appearance.stage.background.dropdown-fill.label",
          "typography.roles.bigBang.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.body.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.button.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.localeSwitcher.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.title.color": "$label:typography.color.dropdown-fill.label"
        },
        "dropdown-border": {
          "appearance.headerCta.border": "$label:appearance.header-cta.border.dropdown-border.label",
          "appearance.localeSwitcherBorder": "$label:appearance.locale-switcher.border.dropdown-border.label",
          "appearance.podBorder": "$label:appearance.pod-border.dropdown-border.label"
        }
      }
    },
    "panels": [
      {
        "id": "content",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-content"
          },
          {
            "label": "$label:content.cluster.content.label",
            "initiallyOpen": true,
            "nodes": [
              {
                "kind": "field",
                "type": "dropdown-edit",
                "path": "bigBang.statement",
                "label": "$label:content.field.big-bang.statement.dropdown-edit.label",
                "attrs": {
                  "size": "lg",
                  "placeholder": "$label:content.field.big-bang.statement.dropdown-edit.attr.placeholder",
                  "required": true
                }
              },
              {
                "kind": "field",
                "type": "toggle",
                "path": "bigBang.showSupportingCopy",
                "label": "$label:content.field.big-bang.show-supporting-copy.toggle.label",
                "attrs": {
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "dropdown-edit",
                "path": "bigBang.supportingCopy",
                "label": "$label:content.field.big-bang.supporting-copy.dropdown-edit.label",
                "attrs": {
                  "size": "md",
                  "placeholder": "$label:content.field.big-bang.supporting-copy.dropdown-edit.attr.placeholder"
                },
                "showIf": {
                  "path": "bigBang.showSupportingCopy",
                  "op": "isTrue"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "typography",
        "shared": {
          "id": "typography",
          "roleLabels": {
            "bigBang": "$label:typography.role.big-bang.label",
            "body": "$label:typography.role.body.label"
          }
        }
      },
      {
        "id": "layout",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-layout"
          },
          {
            "kind": "shared",
            "id": "core-size"
          },
          {
            "label": "$label:layout.cluster.big-bang-layout.label",
            "nodes": [
              {
                "kind": "field",
                "type": "choice-tiles",
                "path": "bigBang.alignment",
                "label": "$label:layout.field.big-bang.alignment.choice-tiles.label",
                "attrs": {
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.big-bang.alignment.choice-tiles.option.left.label",
                      "value": "left"
                    },
                    {
                      "label": "$label:layout.field.big-bang.alignment.choice-tiles.option.center.label",
                      "value": "center"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "path": "bigBang.textWidth",
                "label": "$label:layout.field.big-bang.text-width.valuefield.label",
                "attrs": {
                  "min": 480,
                  "max": 1280,
                  "step": 10
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "path": "bigBang.gap",
                "label": "$label:layout.field.big-bang.gap.valuefield.label",
                "attrs": {
                  "min": 8,
                  "max": 80,
                  "step": 2
                }
              }
            ]
          },
          {
            "kind": "shared",
            "id": "stagepod-layout"
          }
        ]
      },
      {
        "id": "appearance",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-appearance"
          },
          {
            "kind": "shared",
            "id": "stagepod-appearance"
          }
        ]
      },
      {
        "id": "settings",
        "clusters": [
          {
            "kind": "shared",
            "id": "settings-behavior"
          }
        ]
      }
    ]
  }
}
