{
  "widgetname": "logoshowcase",
  "displayName": "Logo Showcase",
  "description": "",
  "normalization": {
    "idRules": [
      {
        "arrayPath": "logoshowcase.strips",
        "idKey": "id"
      },
      {
        "arrayPath": "logoshowcase.strips[].logos",
        "idKey": "id"
      }
    ]
  },
  "defaults": {
    "uiLabels": {
      "core": {
        "singular": "$label:core.singular",
        "plural": "$label:core.plural",
        "sizeCluster": "$label:core.size-cluster"
      }
    },
    "logoshowcase": {
      "type": "grid",
      "strips": [
        {
          "id": "s1",
          "logos": [
            {
              "id": "l1",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            },
            {
              "id": "l2",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            },
            {
              "id": "l3",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            },
            {
              "id": "l4",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            },
            {
              "id": "l5",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            },
            {
              "id": "l6",
              "alt": "",
              "href": "",
              "name": "",
              "title": "",
              "caption": "",
              "logoFill": {
                "type": "none"
              },
              "nofollow": false,
              "targetBlank": false
            }
          ]
        }
      ],
      "spacing": {
        "gap": 20,
        "rowGap": 16,
        "stripGap": 16,
        "mobileGap": 16,
        "logoHeight": 40,
        "mobileStripGap": 12
      },
      "behavior": {
        "randomOrder": false
      },
      "appearance": {
        "cardwrapper": {
          "border": {
            "color": "color-mix(in oklab, var(--color-system-black), transparent 88%)",
            "width": 1,
            "enabled": false
          },
          "radius": "4xl",
          "shadow": {
            "x": 0,
            "y": 8,
            "blur": 24,
            "alpha": 18,
            "color": "#000000",
            "inset": false,
            "spread": 0,
            "enabled": false
          },
          "radiusBL": "4xl",
          "radiusBR": "4xl",
          "radiusTL": "4xl",
          "radiusTR": "4xl",
          "radiusLinked": true
        },
        "logoLook": "original",
        "logoOpacity": 0.9,
        "itemBackground": {
          "type": "none"
        }
      },
      "typeConfig": {
        "carousel": {
          "mode": "paged",
          "step": "page",
          "speed": 30,
          "autoplay": false,
          "direction": "left",
          "allowSwipe": true,
          "showArrows": true,
          "pauseOnHover": true,
          "transitionMs": 350,
          "autoSlideDelayMs": 2500
        }
      }
    }
  },
  "editor": {
    "labels": {
      "components": {
        "agent-activity": {
          "title": "$label:component.agent-activity.title"
        },
        "dropdown-border": {
          "color": "$label:component.dropdown-border.color.label",
          "defaultColors": "$label:component.dropdown-border.default-colors.label",
          "enabled": "$label:component.dropdown-border.enabled.label",
          "hex": "$label:component.dropdown-border.hex.label",
          "hue": "$label:component.dropdown-border.hue.label",
          "width": "$label:component.dropdown-border.width.label"
        },
        "dropdown-edit": {
          "addLink": "$label:component.dropdown-edit.add-link.label",
          "bold": "$label:component.dropdown-edit.bold.label",
          "clearFormatting": "$label:component.dropdown-edit.clear-formatting.label",
          "italic": "$label:component.dropdown-edit.italic.label",
          "link": "$label:component.dropdown-edit.link.label",
          "removeLink": "$label:component.dropdown-edit.remove-link.label",
          "strikethrough": "$label:component.dropdown-edit.strikethrough.label",
          "underline": "$label:component.dropdown-edit.underline.label",
          "url": "$label:component.dropdown-edit.url.label"
        },
        "dropdown-fill": {
          "addGradientStop": "$label:component.dropdown-fill.add-gradient-stop.label",
          "angle": "$label:component.dropdown-fill.angle.label",
          "chooseAssets": "$label:component.dropdown-fill.choose-assets.label",
          "color": "$label:component.dropdown-fill.color.label",
          "colorFill": "$label:component.dropdown-fill.color-fill.label",
          "defaultColors": "$label:component.dropdown-fill.default-colors.label",
          "editGradientStop": "$label:component.dropdown-fill.edit-gradient-stop.label",
          "gradientFill": "$label:component.dropdown-fill.gradient-fill.label",
          "gradientStops": "$label:component.dropdown-fill.gradient-stops.label",
          "hex": "$label:component.dropdown-fill.hex.label",
          "hue": "$label:component.dropdown-fill.hue.label",
          "imageFill": "$label:component.dropdown-fill.image-fill.label",
          "loadAssetsError": "$label:component.dropdown-fill.load-assets-error.label",
          "loadingAssets": "$label:component.dropdown-fill.loading-assets.label",
          "noAssets": "$label:component.dropdown-fill.no-assets.label",
          "opacity": "$label:component.dropdown-fill.opacity.label",
          "previewAssetError": "$label:component.dropdown-fill.preview-asset-error.label",
          "removeAsset": "$label:component.dropdown-fill.remove-asset.label",
          "enabled": "$label:component.dropdown-fill.enabled.label",
          "removeGradientStop": "$label:component.dropdown-fill.remove-gradient-stop.label",
          "upload": "$label:component.dropdown-fill.upload.label",
          "uploadAssetError": "$label:component.dropdown-fill.upload-asset-error.label",
          "useAsset": "$label:component.dropdown-fill.use-asset.label",
          "videoFill": "$label:component.dropdown-fill.video-fill.label"
        }
      },
      "fields": {
        "dropdown-fill": {
          "appearance.headerCta.background": "$label:appearance.header-cta.background.dropdown-fill.label",
          "appearance.headerCta.textColor": "$label:appearance.header-cta.text-color.dropdown-fill.label",
          "appearance.localeSwitcherBackground": "$label:appearance.locale-switcher.background.dropdown-fill.label",
          "appearance.localeSwitcherTextColor": "$label:appearance.locale-switcher.text-color.dropdown-fill.label",
          "pod.background": "$label:appearance.pod.background.dropdown-fill.label",
          "stage.background": "$label:appearance.stage.background.dropdown-fill.label",
          "typography.roles.body.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.button.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.localeSwitcher.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.title.color": "$label:typography.color.dropdown-fill.label"
        },
        "dropdown-border": {
          "appearance.headerCta.border": "$label:appearance.header-cta.border.dropdown-border.label",
          "appearance.localeSwitcherBorder": "$label:appearance.locale-switcher.border.dropdown-border.label",
          "appearance.podBorder": "$label:appearance.pod-border.dropdown-border.label"
        }
      }
    },
    "panels": [
      {
        "id": "content",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-content"
          },
          {
            "label": "$label:content.cluster.content.label",
            "initiallyOpen": true,
            "nodes": [
              {
                "kind": "field",
                "type": "segmented",
                "groupId": "content-type",
                "path": "logoshowcase.type",
                "label": "$label:content.field.logoshowcase.type.segmented.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "value": "{{logoshowcase.type}}",
                  "options": [
                    {
                      "label": "$label:content.field.logoshowcase.type.segmented.option.grid.label",
                      "value": "grid",
                      "icon": "circle.grid.2x2"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.type.segmented.option.carousel.label",
                      "value": "carousel",
                      "icon": "ellipsis"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "object-manager",
                "groupId": "content-logos",
                "path": "logoshowcase.strips",
                "label": "$label:content.field.logoshowcase.strips.object-manager.label",
                "template": [
                  {
                    "kind": "field",
                    "type": "repeater",
                    "path": "logoshowcase.strips.__STRIP__.logos",
                    "label": "$label:content.field.logoshowcase.strips.strip.logos.repeater.label",
                    "template": [
                      {
                        "kind": "field",
                        "type": "dropdown-fill",
                        "path": "logoshowcase.strips.__STRIP__.logos.__INDEX__.logoFill",
                        "label": "$label:content.field.logoshowcase.strips.strip.logos.index.logo-fill.dropdown-fill.label",
                        "template": [
                          {
                            "kind": "field",
                            "type": "textfield",
                            "path": "logoshowcase.strips.__STRIP__.logos.__INDEX__.name",
                            "label": "$label:content.field.logoshowcase.strips.strip.logos.index.name.textfield.label",
                            "attrs": {
                              "size": "sm",
                              "placeholder": "$label:content.field.logoshowcase.strips.strip.logos.index.name.textfield.attr.placeholder"
                            }
                          },
                          {
                            "kind": "field",
                            "type": "textfield",
                            "path": "logoshowcase.strips.__STRIP__.logos.__INDEX__.caption",
                            "label": "$label:content.field.logoshowcase.strips.strip.logos.index.caption.textfield.label",
                            "attrs": {
                              "size": "sm",
                              "placeholder": "$label:content.field.logoshowcase.strips.strip.logos.index.caption.textfield.attr.placeholder"
                            }
                          }
                        ],
                        "attrs": {
                          "size": "md",
                          "fill-modes": "image",
                          "placeholder": "$label:content.field.logoshowcase.strips.strip.logos.index.logo-fill.dropdown-fill.attr.placeholder"
                        }
                      }
                    ],
                    "attrs": {
                      "size": "md",
                      "add-label": "$label:content.field.logoshowcase.strips.strip.logos.repeater.attr.add-label",
                      "remove-label": "$label:content.field.logoshowcase.strips.strip.logos.repeater.attr.remove-label",
                      "move-label": "$label:content.field.logoshowcase.strips.strip.logos.repeater.attr.move-label",
                      "reorder-label": "$label:content.field.logoshowcase.strips.strip.logos.repeater.attr.reorder-label",
                      "reorder-title": "$label:content.field.logoshowcase.strips.strip.logos.repeater.attr.reorder-title",
                      "add-open": "bulk-edit",
                      "min": "1",
                      "default-item": {
                        "name": "New logo",
                        "logoFill": {
                          "type": "none"
                        },
                        "href": "",
                        "targetBlank": false,
                        "nofollow": false,
                        "alt": "",
                        "title": "",
                        "caption": ""
                      }
                    }
                  }
                ],
                "attrs": {
                  "group-label": "",
                  "class": "diet-object-manager",
                  "add-label": "$label:content.field.logoshowcase.strips.object-manager.attr.add-label",
                  "reorder-label": "$label:content.field.logoshowcase.strips.object-manager.attr.reorder-label",
                  "reorder-title": "$label:content.field.logoshowcase.strips.object-manager.attr.reorder-title",
                  "label-path": "logos.0.name",
                  "index-token": "__STRIP__",
                  "min": "1",
                  "default-item": {
                    "logos": [
                      {
                        "name": "New logo",
                        "logoFill": {
                          "type": "none"
                        },
                        "href": "",
                        "targetBlank": false,
                        "nofollow": false,
                        "alt": "",
                        "title": "",
                        "caption": ""
                      }
                    ]
                  }
                }
              },
              {
                "kind": "field",
                "type": "bulk-edit",
                "groupId": "content-logos",
                "path": "logoshowcase.strips",
                "label": "$label:content.field.logoshowcase.strips.bulk-edit.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "row-path": "logos",
                  "title": "$label:content.field.logoshowcase.strips.bulk-edit.attr.title",
                  "empty-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.empty-label",
                  "close-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.close-label",
                  "cancel-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.cancel-label",
                  "save-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.save-label",
                  "discard-title": "$label:content.field.logoshowcase.strips.bulk-edit.attr.discard-title",
                  "discard-message": "$label:content.field.logoshowcase.strips.bulk-edit.attr.discard-message",
                  "keep-editing-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.keep-editing-label",
                  "discard-label": "$label:content.field.logoshowcase.strips.bulk-edit.attr.discard-label",
                  "columns": [
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.name.label",
                      "path": "name",
                      "control": "text"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.caption.label",
                      "path": "caption",
                      "control": "text"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.href.label",
                      "path": "href",
                      "control": "text",
                      "placeholder": "$label:content.field.logoshowcase.strips.bulk-edit.column.href.placeholder"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.target-blank.label",
                      "path": "targetBlank",
                      "control": "checkbox"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.nofollow.label",
                      "path": "nofollow",
                      "control": "checkbox"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.alt.label",
                      "path": "alt",
                      "control": "text"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.strips.bulk-edit.column.title.label",
                      "path": "title",
                      "control": "text"
                    }
                  ]
                }
              }
            ]
          },
          {
            "label": "$label:content.cluster.carousel.label",
            "nodes": [
              {
                "kind": "field",
                "type": "segmented",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.mode",
                "label": "$label:content.field.logoshowcase.type-config.carousel.mode.segmented.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.mode.segmented.option.paged.label",
                      "value": "paged"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.mode.segmented.option.continuous.label",
                      "value": "continuous"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "segmented",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.step",
                "label": "$label:content.field.logoshowcase.type-config.carousel.step.segmented.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "paged"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.step.segmented.option.logo.label",
                      "value": "logo"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.step.segmented.option.page.label",
                      "value": "page"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "toggle",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.showArrows",
                "label": "$label:content.field.logoshowcase.type-config.carousel.show-arrows.toggle.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "paged"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "toggle",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.allowSwipe",
                "label": "$label:content.field.logoshowcase.type-config.carousel.allow-swipe.toggle.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "paged"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "toggle",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.autoplay",
                "label": "$label:content.field.logoshowcase.type-config.carousel.autoplay.toggle.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "paged"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.autoSlideDelayMs",
                "label": "$label:content.field.logoshowcase.type-config.carousel.auto-slide-delay-ms.valuefield.label",
                "showIf": {
                  "all": [
                    {
                      "path": "logoshowcase.typeConfig.carousel.mode",
                      "op": "equals",
                      "value": "paged"
                    },
                    {
                      "path": "logoshowcase.typeConfig.carousel.autoplay",
                      "op": "isTrue"
                    }
                  ]
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.transitionMs",
                "label": "$label:content.field.logoshowcase.type-config.carousel.transition-ms.valuefield.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "paged"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.speed",
                "label": "$label:content.field.logoshowcase.type-config.carousel.speed.valuefield.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "continuous"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "dropdown-actions",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.direction",
                "label": "$label:content.field.logoshowcase.type-config.carousel.direction.dropdown-actions.label",
                "showIf": {
                  "path": "logoshowcase.typeConfig.carousel.mode",
                  "op": "equals",
                  "value": "continuous"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "value": "{{logoshowcase.typeConfig.carousel.direction}}",
                  "options": [
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.direction.dropdown-actions.option.left.label",
                      "value": "left"
                    },
                    {
                      "label": "$label:content.field.logoshowcase.type-config.carousel.direction.dropdown-actions.option.right.label",
                      "value": "right"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "toggle",
                "groupId": "carousel-settings",
                "path": "logoshowcase.typeConfig.carousel.pauseOnHover",
                "label": "$label:content.field.logoshowcase.type-config.carousel.pause-on-hover.toggle.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              }
            ],
            "showIf": {
              "path": "logoshowcase.type",
              "op": "equals",
              "value": "carousel"
            }
          }
        ]
      },
      {
        "id": "typography",
        "shared": {
          "id": "typography"
        }
      },
      {
        "id": "layout",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-layout"
          },
          {
            "kind": "shared",
            "id": "core-size"
          },
          {
            "nodes": [
              {
                "kind": "field",
                "type": "slider",
                "groupId": "spacing-settings",
                "path": "logoshowcase.spacing.logoHeight",
                "label": "$label:layout.field.logoshowcase.spacing.logo-height.slider.label",
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "min": 40,
                  "max": 400
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "spacing-settings",
                "path": "logoshowcase.spacing.gap",
                "label": "$label:layout.field.logoshowcase.spacing.gap.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "spacing-settings",
                "path": "logoshowcase.spacing.rowGap",
                "label": "$label:layout.field.logoshowcase.spacing.row-gap.valuefield.label",
                "showIf": {
                  "path": "logoshowcase.type",
                  "op": "equals",
                  "value": "grid"
                },
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "spacing-settings",
                "path": "logoshowcase.spacing.stripGap",
                "label": "$label:layout.field.logoshowcase.spacing.strip-gap.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "groupId": "spacing-mobile",
                "path": "logoshowcase.spacing.mobileGap",
                "label": "$label:layout.field.logoshowcase.spacing.mobile-gap.valuefield.label",
                "attrs": {
                  "group-label": "",
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
