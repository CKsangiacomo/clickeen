{
  "widgetname": "cards",
  "displayName": "Cards",
  "description": "",
  "defaults": {
    "uiLabels": {
      "core": {
        "singular": "$label:core.singular",
        "plural": "$label:core.plural",
        "sizeCluster": "$label:core.size-cluster"
      }
    },
    "typography": {
      "roles": {
        "cardTitle": {
          "color": {
            "type": "color",
            "color": "var(--color-system-black)"
          },
          "family": "Inter",
          "weight": "700",
          "fontStyle": "normal",
          "sizeCustom": 24,
          "sizePreset": "m",
          "trackingCustom": 0,
          "trackingPreset": "normal",
          "lineHeightCustom": 1.15,
          "lineHeightPreset": "tight"
        },
        "cardCopy": {
          "color": {
            "type": "color",
            "color": "color-mix(in oklab, var(--color-system-black), transparent 28%)"
          },
          "family": "Inter",
          "weight": "400",
          "fontStyle": "normal",
          "sizeCustom": 17,
          "sizePreset": "m",
          "trackingCustom": 0,
          "trackingPreset": "normal",
          "lineHeightCustom": 1.45,
          "lineHeightPreset": "normal"
        }
      },
      "roleScales": {
        "cardTitle": {
          "l": "28px",
          "m": "24px",
          "s": "20px",
          "xl": "32px",
          "xs": "18px"
        },
        "cardCopy": {
          "l": "19px",
          "m": "17px",
          "s": "15px",
          "xl": "22px",
          "xs": "13px"
        }
      }
    },
    "cards": {
      "appearance": {
        "cardwrapper": {
          "border": {
            "enabled": true,
            "width": 1,
            "color": "var(--color-system-gray-5)"
          },
          "radiusLinked": true,
          "radius": "2xl",
          "radiusTL": "2xl",
          "radiusTR": "2xl",
          "radiusBR": "2xl",
          "radiusBL": "2xl",
          "shadow": {
            "enabled": false,
            "x": 0,
            "y": 0,
            "blur": 0,
            "spread": 0,
            "alpha": 0,
            "color": "#000000",
            "inset": false
          }
        }
      },
      "items": [
        {
          "id": "card-1",
          "title": "Global by default",
          "copy": "Publish once and keep every version aligned from one source of truth.",
          "media": {
            "kind": "icon",
            "iconName": "globe",
            "image": {
              "type": "none"
            },
            "imageAlt": ""
          },
          "link": {
            "enabled": false,
            "href": "#",
            "label": "See details"
          },
          "style": {
            "background": {
              "type": "none"
            },
            "borderColor": {
              "type": "none"
            },
            "accentColor": {
              "type": "none"
            },
            "textTone": "inherit"
          }
        },
        {
          "id": "card-2",
          "title": "Built for websites",
          "copy": "Embed instances in any website while each card stays easy to edit.",
          "media": {
            "kind": "icon",
            "iconName": "square.stack.3d.up",
            "image": {
              "type": "none"
            },
            "imageAlt": ""
          },
          "link": {
            "enabled": false,
            "href": "#",
            "label": "See details"
          },
          "style": {
            "background": {
              "type": "none"
            },
            "borderColor": {
              "type": "none"
            },
            "accentColor": {
              "type": "none"
            },
            "textTone": "inherit"
          }
        },
        {
          "id": "card-3",
          "title": "Simple to operate",
          "copy": "Use the same Shell controls for layout, appearance, typography, and publishing.",
          "media": {
            "kind": "icon",
            "iconName": "checkmark",
            "image": {
              "type": "none"
            },
            "imageAlt": ""
          },
          "link": {
            "enabled": false,
            "href": "#",
            "label": "See details"
          },
          "style": {
            "background": {
              "type": "none"
            },
            "borderColor": {
              "type": "none"
            },
            "accentColor": {
              "type": "none"
            },
            "textTone": "inherit"
          }
        }
      ],
      "treatment": "cards",
      "columns": 3,
      "gap": 24,
      "cardPadding": 32,
      "customCardStyles": {
        "enabled": false
      },
      "betweenCards": {
        "enabled": false,
        "kind": "line",
        "line": {
          "widthPt": 2,
          "color": {
            "type": "color",
            "color": "#D7D7DA"
          }
        },
        "icon": {
          "name": "chevron.right",
          "sizePt": 28,
          "color": {
            "type": "color",
            "color": "#222222"
          }
        }
      }
    }
  },
  "editor": {
    "labels": {
      "components": {
        "agent-activity": {
          "title": "$label:component.agent-activity.title"
        },
        "dropdown-border": {
          "color": "$label:component.dropdown-border.color.label",
          "defaultColors": "$label:component.dropdown-border.default-colors.label",
          "enabled": "$label:component.dropdown-border.enabled.label",
          "hex": "$label:component.dropdown-border.hex.label",
          "hue": "$label:component.dropdown-border.hue.label",
          "width": "$label:component.dropdown-border.width.label"
        },
        "dropdown-edit": {
          "addLink": "$label:component.dropdown-edit.add-link.label",
          "bold": "$label:component.dropdown-edit.bold.label",
          "clearFormatting": "$label:component.dropdown-edit.clear-formatting.label",
          "italic": "$label:component.dropdown-edit.italic.label",
          "link": "$label:component.dropdown-edit.link.label",
          "removeLink": "$label:component.dropdown-edit.remove-link.label",
          "strikethrough": "$label:component.dropdown-edit.strikethrough.label",
          "underline": "$label:component.dropdown-edit.underline.label",
          "url": "$label:component.dropdown-edit.url.label"
        },
        "dropdown-shadow": {
          "aboveContent": "$label:component.dropdown-shadow.above-content.label",
          "belowContent": "$label:component.dropdown-shadow.below-content.label",
          "blur": "$label:component.dropdown-shadow.blur.label",
          "color": "$label:component.dropdown-shadow.color.label",
          "defaultColors": "$label:component.dropdown-shadow.default-colors.label",
          "enabled": "$label:component.dropdown-shadow.enabled.label",
          "hex": "$label:component.dropdown-shadow.hex.label",
          "horizontal": "$label:component.dropdown-shadow.horizontal.label",
          "hue": "$label:component.dropdown-shadow.hue.label",
          "layer": "$label:component.dropdown-shadow.layer.label",
          "opacity": "$label:component.dropdown-shadow.opacity.label",
          "preview": "$label:component.dropdown-shadow.preview.label",
          "spread": "$label:component.dropdown-shadow.spread.label",
          "vertical": "$label:component.dropdown-shadow.vertical.label"
        },
        "dropdown-fill": {
          "addGradientStop": "$label:component.dropdown-fill.add-gradient-stop.label",
          "angle": "$label:component.dropdown-fill.angle.label",
          "chooseAssets": "$label:component.dropdown-fill.choose-assets.label",
          "color": "$label:component.dropdown-fill.color.label",
          "colorFill": "$label:component.dropdown-fill.color-fill.label",
          "defaultColors": "$label:component.dropdown-fill.default-colors.label",
          "editGradientStop": "$label:component.dropdown-fill.edit-gradient-stop.label",
          "gradientFill": "$label:component.dropdown-fill.gradient-fill.label",
          "gradientStops": "$label:component.dropdown-fill.gradient-stops.label",
          "hex": "$label:component.dropdown-fill.hex.label",
          "hue": "$label:component.dropdown-fill.hue.label",
          "imageFill": "$label:component.dropdown-fill.image-fill.label",
          "loadAssetsError": "$label:component.dropdown-fill.load-assets-error.label",
          "loadingAssets": "$label:component.dropdown-fill.loading-assets.label",
          "noAssets": "$label:component.dropdown-fill.no-assets.label",
          "opacity": "$label:component.dropdown-fill.opacity.label",
          "previewAssetError": "$label:component.dropdown-fill.preview-asset-error.label",
          "removeAsset": "$label:component.dropdown-fill.remove-asset.label",
          "enabled": "$label:component.dropdown-fill.enabled.label",
          "removeGradientStop": "$label:component.dropdown-fill.remove-gradient-stop.label",
          "upload": "$label:component.dropdown-fill.upload.label",
          "uploadAssetError": "$label:component.dropdown-fill.upload-asset-error.label",
          "useAsset": "$label:component.dropdown-fill.use-asset.label",
          "videoFill": "$label:component.dropdown-fill.video-fill.label"
        }
      },
      "fields": {
        "dropdown-shadow": {
          "cards.appearance.cardwrapper.shadow": "$label:appearance.cards.cardwrapper.shadow.dropdown-shadow.label",
          "pod.insideShadow.all": "$label:appearance.pod.inside-shadow.all.dropdown-shadow.label",
          "pod.insideShadow.bottom": "$label:appearance.pod.inside-shadow.bottom.dropdown-shadow.label",
          "pod.insideShadow.left": "$label:appearance.pod.inside-shadow.left.dropdown-shadow.label",
          "pod.insideShadow.linked": "$label:appearance.pod.inside-shadow.linked.toggle.label",
          "pod.insideShadow.right": "$label:appearance.pod.inside-shadow.right.dropdown-shadow.label",
          "pod.insideShadow.top": "$label:appearance.pod.inside-shadow.top.dropdown-shadow.label",
          "pod.shadow": "$label:appearance.pod.shadow.dropdown-shadow.label",
          "stage.insideShadow.all": "$label:appearance.stage.inside-shadow.all.dropdown-shadow.label",
          "stage.insideShadow.bottom": "$label:appearance.stage.inside-shadow.bottom.dropdown-shadow.label",
          "stage.insideShadow.left": "$label:appearance.stage.inside-shadow.left.dropdown-shadow.label",
          "stage.insideShadow.linked": "$label:appearance.stage.inside-shadow.linked.toggle.label",
          "stage.insideShadow.right": "$label:appearance.stage.inside-shadow.right.dropdown-shadow.label",
          "stage.insideShadow.top": "$label:appearance.stage.inside-shadow.top.dropdown-shadow.label",
          "stage.shadow": "$label:appearance.stage.shadow.dropdown-shadow.label"
        },
        "dropdown-fill": {
          "appearance.headerCta.background": "$label:appearance.header-cta.background.dropdown-fill.label",
          "appearance.headerCta.textColor": "$label:appearance.header-cta.text-color.dropdown-fill.label",
          "appearance.localeSwitcherBackground": "$label:appearance.locale-switcher.background.dropdown-fill.label",
          "appearance.localeSwitcherTextColor": "$label:appearance.locale-switcher.text-color.dropdown-fill.label",
          "pod.background": "$label:appearance.pod.background.dropdown-fill.label",
          "stage.background": "$label:appearance.stage.background.dropdown-fill.label",
          "typography.roles.body.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.button.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.cardCopy.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.cardTitle.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.localeSwitcher.color": "$label:typography.color.dropdown-fill.label",
          "typography.roles.title.color": "$label:typography.color.dropdown-fill.label"
        },
        "dropdown-border": {
          "appearance.headerCta.border": "$label:appearance.header-cta.border.dropdown-border.label",
          "appearance.localeSwitcherBorder": "$label:appearance.locale-switcher.border.dropdown-border.label",
          "appearance.podBorder": "$label:appearance.pod-border.dropdown-border.label",
          "cards.appearance.cardwrapper.border": "$label:appearance.field.cards.appearance.cardwrapper.border.dropdown-border.label"
        }
      }
    },
    "panels": [
      {
        "id": "content",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-content"
          },
          {
            "label": "$label:content.cluster.content.label",
            "initiallyOpen": true,
            "nodes": [
              {
                "kind": "field",
                "type": "repeater",
                "groupId": "content-cards",
                "path": "cards.items",
                "label": "$label:content.field.cards.items.repeater.label",
                "template": [
                  {
                    "kind": "field",
                    "type": "dropdown-edit",
                    "path": "cards.items.__INDEX__.title",
                    "label": "$label:content.field.cards.items.index.title.dropdown-edit.label",
                    "attrs": {
                      "size": "md",
                      "placeholder": "$label:content.field.cards.items.index.title.dropdown-edit.attr.placeholder",
                      "required": true
                    }
                  },
                  {
                    "kind": "field",
                    "type": "dropdown-edit",
                    "path": "cards.items.__INDEX__.copy",
                    "label": "$label:content.field.cards.items.index.copy.dropdown-edit.label",
                    "attrs": {
                      "size": "md",
                      "placeholder": "$label:content.field.cards.items.index.copy.dropdown-edit.attr.placeholder",
                      "required": true
                    }
                  },
                  {
                    "kind": "field",
                    "type": "dropdown-actions",
                    "path": "cards.items.__INDEX__.media.kind",
                    "label": "$label:content.field.cards.items.index.media.kind.dropdown-actions.label",
                    "attrs": {
                      "size": "md",
                      "options": [
                        {
                          "label": "$label:content.field.cards.items.index.media.kind.dropdown-actions.option.none.label",
                          "value": "none"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.kind.dropdown-actions.option.icon.label",
                          "value": "icon"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.kind.dropdown-actions.option.image.label",
                          "value": "image"
                        }
                      ]
                    }
                  },
                  {
                    "kind": "field",
                    "type": "dropdown-actions",
                    "path": "cards.items.__INDEX__.media.iconName",
                    "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.label",
                    "attrs": {
                      "size": "md",
                      "options": [
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.checkmark.label",
                          "value": "checkmark"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.globe.label",
                          "value": "globe"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.square.stack.3d.up.label",
                          "value": "square.stack.3d.up"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.arrow.right.label",
                          "value": "arrow.right"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.chevron.right.label",
                          "value": "chevron.right"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.arrowshape.forward.label",
                          "value": "arrowshape.forward"
                        },
                        {
                          "label": "$label:content.field.cards.items.index.media.icon-name.dropdown-actions.option.arrowshape.turn.up.right.label",
                          "value": "arrowshape.turn.up.right"
                        }
                      ]
                    },
                    "showIf": {
                      "path": "cards.items.__INDEX__.media.kind",
                      "op": "equals",
                      "value": "icon"
                    }
                  },
                  {
                    "kind": "field",
                    "type": "dropdown-fill",
                    "path": "cards.items.__INDEX__.media.image",
                    "label": "$label:content.field.cards.items.index.media.image.dropdown-fill.label",
                    "attrs": {
                      "size": "md",
                      "fill-modes": "image"
                    },
                    "showIf": {
                      "path": "cards.items.__INDEX__.media.kind",
                      "op": "equals",
                      "value": "image"
                    }
                  },
                  {
                    "kind": "field",
                    "type": "textfield",
                    "path": "cards.items.__INDEX__.media.imageAlt",
                    "label": "$label:content.field.cards.items.index.media.image-alt.textfield.label",
                    "showIf": {
                      "path": "cards.items.__INDEX__.media.kind",
                      "op": "equals",
                      "value": "image"
                    }
                  },
                  {
                    "kind": "field",
                    "type": "toggle",
                    "path": "cards.items.__INDEX__.link.enabled",
                    "label": "$label:content.field.cards.items.index.link.enabled.toggle.label",
                    "attrs": {
                      "size": "md"
                    }
                  },
                  {
                    "kind": "field",
                    "type": "textfield",
                    "path": "cards.items.__INDEX__.link.href",
                    "label": "$label:content.field.cards.items.index.link.href.textfield.label",
                    "showIf": {
                      "path": "cards.items.__INDEX__.link.enabled",
                      "op": "isTrue"
                    }
                  },
                  {
                    "kind": "field",
                    "type": "textfield",
                    "path": "cards.items.__INDEX__.link.label",
                    "label": "$label:content.field.cards.items.index.link.label.textfield.label",
                    "showIf": {
                      "path": "cards.items.__INDEX__.link.enabled",
                      "op": "isTrue"
                    }
                  }
                ],
                "attrs": {
                  "group-label": "",
                  "size": "md",
                  "add-label": "$label:content.field.cards.items.repeater.attr.add-label",
                  "remove-label": "$label:content.field.cards.items.repeater.attr.remove-label",
                  "move-label": "$label:content.field.cards.items.repeater.attr.move-label",
                  "reorder-label": "$label:content.field.cards.items.repeater.attr.reorder-label",
                  "reorder-title": "$label:content.field.cards.items.repeater.attr.reorder-title",
                  "index-token": "__INDEX__",
                  "min": "2",
                  "max": "16",
                  "default-item": {
                    "id": "",
                    "title": "New card",
                    "copy": "Add supporting copy.",
                    "media": {
                      "kind": "none",
                      "iconName": "checkmark",
                      "imageAlt": ""
                    },
                    "link": {
                      "enabled": false,
                      "href": "#",
                      "label": "Learn more"
                    },
                    "style": {
                      "background": {
                        "type": "none"
                      },
                      "borderColor": {
                        "type": "none"
                      },
                      "accentColor": {
                        "type": "none"
                      },
                      "textTone": "inherit"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "id": "typography",
        "shared": {
          "id": "typography",
          "roleLabels": {
            "cardTitle": "$label:typography.role.card-title.label",
            "cardCopy": "$label:typography.role.card-copy.label"
          }
        }
      },
      {
        "id": "layout",
        "clusters": [
          {
            "kind": "shared",
            "id": "header-layout"
          },
          {
            "kind": "shared",
            "id": "core-size"
          },
          {
            "label": "$label:layout.cluster.cards-layout.label",
            "nodes": [
              {
                "kind": "field",
                "type": "choice-tiles",
                "path": "cards.treatment",
                "label": "$label:layout.field.cards.treatment.choice-tiles.label",
                "attrs": {
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.cards.treatment.choice-tiles.option.cards.label",
                      "value": "cards"
                    },
                    {
                      "label": "$label:layout.field.cards.treatment.choice-tiles.option.linked-cards.label",
                      "value": "linked-cards"
                    },
                    {
                      "label": "$label:layout.field.cards.treatment.choice-tiles.option.steps.label",
                      "value": "steps"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "choice-tiles",
                "path": "cards.columns",
                "label": "$label:layout.field.cards.columns.choice-tiles.label",
                "attrs": {
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.cards.columns.choice-tiles.option.2.label",
                      "value": 2
                    },
                    {
                      "label": "$label:layout.field.cards.columns.choice-tiles.option.3.label",
                      "value": 3
                    },
                    {
                      "label": "$label:layout.field.cards.columns.choice-tiles.option.4.label",
                      "value": 4
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "path": "cards.gap",
                "label": "$label:layout.field.cards.gap.valuefield.label",
                "attrs": {
                  "min": 8,
                  "max": 64,
                  "step": 1
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "path": "cards.cardPadding",
                "label": "$label:layout.field.cards.card-padding.valuefield.label",
                "attrs": {
                  "min": 16,
                  "max": 64,
                  "step": 1
                }
              }
            ]
          },
          {
            "label": "$label:layout.cluster.graphic-between-cards.label",
            "nodes": [
              {
                "kind": "field",
                "type": "toggle",
                "path": "cards.betweenCards.enabled",
                "label": "$label:layout.field.cards.between-cards.enabled.toggle.label",
                "attrs": {
                  "size": "md"
                }
              },
              {
                "kind": "field",
                "type": "dropdown-actions",
                "path": "cards.betweenCards.kind",
                "label": "$label:layout.field.cards.between-cards.kind.dropdown-actions.label",
                "attrs": {
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.cards.between-cards.kind.dropdown-actions.option.line.label",
                      "value": "line"
                    },
                    {
                      "label": "$label:layout.field.cards.between-cards.kind.dropdown-actions.option.icon.label",
                      "value": "icon"
                    }
                  ]
                },
                "showIf": {
                  "path": "cards.betweenCards.enabled",
                  "op": "isTrue"
                }
              },
              {
                "kind": "field",
                "type": "valuefield",
                "path": "cards.betweenCards.line.widthPt",
                "label": "$label:layout.field.cards.between-cards.line.width-pt.valuefield.label",
                "attrs": {
                  "min": 1,
                  "max": 24,
                  "step": 1
                },
                "showIf": {
                  "all": [
                    {
                      "path": "cards.betweenCards.enabled",
                      "op": "isTrue"
                    },
                    {
                      "path": "cards.betweenCards.kind",
                      "op": "equals",
                      "value": "line"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "dropdown-fill",
                "path": "cards.betweenCards.line.color",
                "label": "$label:layout.field.cards.between-cards.line.color.dropdown-fill.label",
                "attrs": {
                  "size": "md",
                  "fill-modes": "color"
                },
                "showIf": {
                  "all": [
                    {
                      "path": "cards.betweenCards.enabled",
                      "op": "isTrue"
                    },
                    {
                      "path": "cards.betweenCards.kind",
                      "op": "equals",
                      "value": "line"
                    }
                  ]
                }
              },
              {
                "kind": "field",
                "type": "dropdown-actions",
                "path": "cards.betweenCards.icon.name",
                "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.label",
                "attrs": {
                  "size": "md",
                  "options": [
                    {
                      "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.option.checkmark.label",
                      "value": "checkmark"
                    },
                    {
                      "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.option.arrow.right.label",
                      "value": "arrow.right"
                    },
                    {
                      "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.option.chevron.right.label",
                      "value": "chevron.right"
                    },
                    {
                      "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.option.arrowshape.forward.label",
                      "value": "arrowshape.forward"
                    },
                    {
                      "label": "$label:layout.field.cards.between-cards.icon.name.dropdown-actions.option.arrowshape.turn.up.right.label",
                      "value": "arrowshape.turn.up.right"
